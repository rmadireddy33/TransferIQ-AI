      "typeVersion": "1.0.0",
      "display": {
        "label": "StartTransferInvestigation",
        "icon": "play"
      },
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": {
            "type": "literal",
            "expression": "null",
            "fieldType": "string"
          },
          "var": "output"
        }
      },
      "inputs": {}
    },
    {
      "id": "ValidateInput",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "ValidateInput",
        "icon": "code"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output",
          "properties": {
            "transferId": {
              "type": "string"
            },
            "correlationId": {
              "type": "string"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "inputs": {
        "script": "const transferId = $vars.StartTransferInvestigation.output.transferId;\nif (typeof transferId !== 'string' || !/^[A-Za-z0-9_-]{1,64}$/.test(transferId)) throw new Error('INVALID_TRANSFER_INPUT');\nreturn { transferId, correlationId: 'TIQ-' + Date.now() + '-' + Math.random().toString(36).slice(2, 12) };\n",
        "errorHandlingEnabled": true
      }
    },
    {
