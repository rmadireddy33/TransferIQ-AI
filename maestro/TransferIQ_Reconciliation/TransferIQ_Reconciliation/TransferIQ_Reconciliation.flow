                  "subprocessVariables": {
                    "inputOutputs": [
                      {
                        "id": "response",
                        "name": "response",
                        "type": "jsonSchema",
                        "variableType": "inputOutput"
                      },
                      {
                        "id": "error",
                        "name": "error",
                        "type": "jsonSchema",
                        "variableType": "inputOutput"
                      }
                    ]
                  },
                  "outputs": [
                    {
                      "name": "output",
                      "type": "jsonSchema",
                      "source": "=vars.response",
                      "var": "{nodeId}.output",
                      "custom": true
                    },
                    {
                      "name": "error",
                      "type": "jsonSchema",
                      "source": "=vars.error",
                      "var": "{nodeId}.error",
