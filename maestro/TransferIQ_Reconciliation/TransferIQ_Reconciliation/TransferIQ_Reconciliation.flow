                          "var": "response",
                          "internal": true
                        }
                      ]
                    }
                  }
                },
                {
                  "id": "_Implicit_Gateway_PreviewResolutionPlan",
                  "type": "bpmn:ExclusiveGateway",
                  "parentId": "PreviewResolutionPlan",
                  "position": {
                    "x": 0,
                    "y": 0
                  },
                  "condition": "node.data.inputs.branches.length > 0",
                  "data": {
                    "label": "Response branch",
                    "defaultFlowId": "_Implicit_Edge__Implicit_Gateway_PreviewResolutionPlan__Implicit_EndEvent_Default_PreviewResolutionPlan"
                  }
                },
                {
                  "forEach": "node.data.inputs.branches",
                  "id": "_Implicit_EndEvent_{branchName}_PreviewResolutionPlan",
                  "type": "bpmn:EndEvent",
                  "parentId": "PreviewResolutionPlan",
                  "position": {
                    "x": 0,
                    "y": 0
                  },
                  "data": {
                    "label": "{branch.name}"
                  }
                },
                {
                  "id": "_Implicit_EndEvent_Default_PreviewResolutionPlan",
                  "type": "bpmn:EndEvent",
                  "parentId": "PreviewResolutionPlan",
                  "position": {
                    "x": 0,
                    "y": 0
                  },
                  "data": {
                    "label": "Default"
                  }
                },
                {
                  "condition": "hasEdgeFromHandle('error')",
                  "id": "_Implicit_EndEvent_Failure_PreviewResolutionPlan",
                  "type": "bpmn:EndEvent",
                  "parentId": "PreviewResolutionPlan",
                  "position": {
