          "type": "object",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "({\n  ...$vars.ValidateInvestigation.output, workflowOutcome:'REVIEW_FAILED', verificationStatus:'NOT_VERIFIED',\n  planId:(() => {const n=Reflect.get($vars,'ValidateResolutionPlan');return n && Reflect.get(n,'output')?.planId || null;})(), planStatus:null,\n  humanReviewOutcome:null, reviewedDispositions:[], auditReference:null,\n  demoOnly:true, identityVerification:'UNVERIFIED_DEMO_REFERENCE', error:{code:'REVIEW_STEP_FAILED',failedStep:\"ValidateReviewResult\"}\n})",
            "fieldType": "object"
          },
          "var": "result"
        },
        "backendBaseUrl": {
