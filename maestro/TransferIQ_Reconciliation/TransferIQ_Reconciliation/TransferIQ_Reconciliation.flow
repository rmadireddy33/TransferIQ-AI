          "type": "object",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "({\n  transferId: $vars.StartTransferInvestigation.output.transferId || null,\n  reconciliationRunId: null, totalPositions: null, directlyMatched: null,\n  evidenceExplained: null, unresolvedCount: null, costBasisIssues: null,\n  exceptions: [], evidenceReferences: [], workflowOutcome: 'FAILED',\n  correlation: { transferId: $vars.StartTransferInvestigation.output.transferId || null, failedStep: \"ValidateInput\" },\n  error: { code: \"INVALID_TRANSFER_INPUT\", summary: \"Provide a nonempty transferId using letters, digits, hyphens or underscores (maximum 64 characters).\" }\n})",
            "fieldType": "object"
          },
          "var": "result"
        },
