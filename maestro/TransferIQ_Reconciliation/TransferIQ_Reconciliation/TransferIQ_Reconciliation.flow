      "id": "ExtractionFailed",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "Evidence Review Required",
        "icon": "circle-check"
      },
      "inputs": {},
      "outputs": {
        "result": {
          "type": "object",
