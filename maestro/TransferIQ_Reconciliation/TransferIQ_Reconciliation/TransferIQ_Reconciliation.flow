    {
      "id": "BuildResolutionPlan",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "BuildResolutionPlan",
        "icon": "code"
      },
      "inputs": {
        "script": "const report = $vars.ValidateInvestigation.output;\nconst reconciliation = $vars.NormalizeReconciliation.output;\nconst reviewer = $vars.ValidateInput.output.reviewerReference;\nif (report.workflowOutcome !== 'INVESTIGATION_COMPLETED' || report.investigationStatus !== 'COMPLETED' ||\n    report.documentEvidenceStatus !== 'NOT_PROCESSED_IXP_DISABLED' ||\n    typeof reviewer !== 'string' || !reviewer.trim() || reviewer.length > 256 ||\n    !/^[A-Za-z0-9_-]{43}$/.test($vars.CreateDemoRun.output.body.reviewCapability)) {\n  throw new Error('REVIEW_CONFIGURATION_OR_VALIDATION_REQUIRED');\n}\n// Agent prose cannot choose an authorized action. Use immutable backend exceptions.\nreturn {\n  transferId:reconciliation.transferId, reconciliationRunId:reconciliation.reconciliationRunId,\n  agentInvestigationId:$vars.ValidateInput.output.correlationId + ':TransferInvestigationAgent',\n  investigationSummary:report.investigationSummary, overallRiskLevel:report.overallRiskLevel,\n  documentEvidenceStatus:report.documentEvidenceStatus,\n  proposedActions:reconciliation.exceptions.map(e => ({exceptionId:e.exceptionId, securityId:e.securityId,\n    evidenceReferences:e.evidenceReferences,\n    disposition:e.resolutionStatus === 'EXPLAINED' ? 'ACCEPT_VERIFIED_EXPLANATION' :\n      (e.exceptionType.startsWith('COST_BASIS_') ? 'OPEN_COST_BASIS_CASE' : 'ESCALATE_TO_TRANSFER_OPERATIONS')})),\n};\n",
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "837c0048-1d75-4a49-add1-b5d594f2d137"
