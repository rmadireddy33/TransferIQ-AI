      "sourcePort": "default",
      "targetNodeId": "NormalizeReconciliation",
      "targetPort": "input"
    },
    {
      "id": "edge_21",
      "sourceNodeId": "NormalizeReconciliation",
      "sourcePort": "error",
      "targetNodeId": "NormalizeReconciliationFailed",
      "targetPort": "input"
    },
    {
      "id": "edge_22",
      "sourceNodeId": "NormalizeReconciliation",
      "sourcePort": "success",
      "targetNodeId": "NormalizationFailed",
      "targetPort": "input"
    },
    {
      "id": "edge_23",
      "sourceNodeId": "NormalizationFailed",
      "sourcePort": "true",
      "targetNodeId": "FailedReconciliation",
      "targetPort": "input"
    },
    {
      "id": "edge_24",
      "sourceNodeId": "NormalizationFailed",
      "sourcePort": "false",
      "targetNodeId": "RequiresInvestigation",
      "targetPort": "input"
    },
    {
      "id": "edge_25",
      "sourceNodeId": "RequiresInvestigation",
      "sourcePort": "true",
      "targetNodeId": "HasCorporateActionPdf",
      "targetPort": "input"
    },
    {
      "id": "edge_26",
      "sourceNodeId": "HasCorporateActionPdf",
      "sourcePort": "true",
      "targetNodeId": "CorporateActionExtractor",
      "targetPort": "input"
    },
    {
      "id": "edge_27",
      "sourceNodeId": "CorporateActionExtractor",
      "sourcePort": "error",
      "targetNodeId": "ExtractionFailed",
      "targetPort": "input"
    },
    {
      "id": "edge_28",
      "sourceNodeId": "CorporateActionExtractor",
      "sourcePort": "success",
      "targetNodeId": "GetCorporateActionReference",
      "targetPort": "input"
    },
    {
      "id": "edge_29",
      "sourceNodeId": "GetCorporateActionReference",
      "sourcePort": "error",
      "targetNodeId": "ReferenceUnavailable",
      "targetPort": "input"
    },
    {
      "id": "edge_30",
      "sourceNodeId": "GetCorporateActionReference",
      "sourcePort": "default",
      "targetNodeId": "ValidateCorporateAction",
      "targetPort": "input"
    },
    {
      "id": "edge_31",
      "sourceNodeId": "ValidateCorporateAction",
      "sourcePort": "error",
      "targetNodeId": "EvidenceValidationFailed",
      "targetPort": "input"
    },
    {
      "id": "edge_32",
      "sourceNodeId": "ValidateCorporateAction",
      "sourcePort": "success",
      "targetNodeId": "CorporateActionVerified",
      "targetPort": "input"
    },
    {
      "id": "edge_33",
      "sourceNodeId": "CorporateActionVerified",
      "sourcePort": "true",
      "targetNodeId": "InvestigationRequired",
      "targetPort": "input"
    },
    {
      "id": "edge_34",
      "sourceNodeId": "CorporateActionVerified",
      "sourcePort": "false",
      "targetNodeId": "EvidenceReviewRequired",
      "targetPort": "input"
    },
    {
      "id": "edge_35",
      "sourceNodeId": "HasCorporateActionPdf",
      "sourcePort": "false",
      "targetNodeId": "EvidenceUnavailable",
      "targetPort": "input"
    },
    {
      "id": "edge_36",
      "sourceNodeId": "RequiresInvestigation",
      "sourcePort": "false",
      "targetNodeId": "CleanReconciliation",
      "targetPort": "input"
    }
  ],
  "definitions": [
    {
      "nodeType": "core.trigger.manual",
      "version": "1.0",
      "category": "trigger",
      "description": "Start the process manually",
      "tags": [
        "trigger",
        "start",
        "manual"
      ],
      "sortOrder": 80,
      "display": {
        "label": "Manual trigger",
        "icon": "play",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "right",
          "handles": [
            {
              "id": "output",
              "type": "source",
              "handleType": "output",
              "showButton": true,
              "constraints": {
                "forbiddenTargetCategories": [
                  "trigger"
                ]
              }
            }
          ],
          "visible": true
        }
      ],
      "model": {
        "type": "bpmn:StartEvent",
        "entryPointId": true
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the process.",
          "source": "null",
          "var": "output"
        }
      },
      "toolbarExtensions": {
        "design": {
          "actions": [
            {
              "id": "change-trigger-type",
              "icon": "square-mouse-pointer",
              "label": "Change trigger type"
            }
          ]
        }
      }
    },
    {
      "nodeType": "core.action.script",
      "version": "1.1",
      "category": "data-operations",
      "description": "Run custom JavaScript code",
      "tags": [
        "code",
        "javascript",
        "python"
      ],
      "sortOrder": 70,
      "supportsErrorHandling": true,
      "display": {
        "label": "Script",
        "icon": "code"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "success",
              "type": "source",
              "handleType": "output"
            },
            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": {
                "maxConnections": 1
              }
            }
          ]
        }
      ],
      "debug": {
        "runtime": "clientScript"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "script": {
            "type": "string",
            "minLength": 1,
            "errorMessage": "Add a script function",
            "validationSeverity": "warning"
          }
        },
        "required": [
          "script"
        ]
      },
      "inputDefaults": {
        "script": ""
      },
      "outputDefinition": {
        "output": {
          "type": "any",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "form": {
        "id": "script-properties",
        "title": "Script configuration",
        "sections": [
          {
            "id": "script",
            "title": "Script",
            "collapsible": true,
            "defaultExpanded": true,
            "fields": [
              {
                "name": "inputs.script",
                "type": "custom",
                "component": "script-editor",
                "componentProps": {
                  "language": "javascript",
                  "returnType": "any",
                  "validationMode": "script",
                  "minHeight": 200,
                  "fillPanel": true,
                  "placeholder": " // Return any value\nreturn {\n  message: \"Web request response\",\n  data: $vars.httpRequest1.output\n};"
                },
                "label": "Code",
                "description": "JavaScript expression that returns a result"
              }
            ]
          }
        ]
      }
    },
    {
      "nodeType": "core.control.end",
      "version": "1.0",
      "category": "control-flow",
      "description": "Mark the end of a process path",
      "tags": [
        "control-flow",
        "end",
        "finish",
        "complete"
      ],
      "sortOrder": 66,
      "display": {
        "label": "End",
        "icon": "circle-check",
        "shape": "circle"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input"
            }
          ]
        }
      ],
      "model": {
        "type": "bpmn:EndEvent"
      }
    },
    {
      "nodeType": "core.action.http.v2",
      "version": "2.6",
      "category": "connector",
      "description": "HTTP request with managed authentication",
      "tags": [
        "connector",
        "http",
        "api",
        "rest",
        "request"
      ],
      "sortOrder": 21,
      "supportsErrorHandling": true,
      "display": {
        "label": "HTTP Request",
        "icon": "https://cloud.uipath.com/elements_/scaleunit_/58cb4f17-4581-4130-a2ae-52448b37dc03/v3/element/elements/uipath-uipath-http/image"
      },
      "handleConfiguration": [
        {
          "position": "left",
          "handles": [
            {
              "id": "input",
              "type": "target",
              "handleType": "input",
              "label": ""
            }
          ]
        },
        {
          "position": "right",
          "handles": [
            {
              "id": "branch-{item.id}",
              "type": "source",
              "handleType": "output",
              "label": "{item.name}",
              "repeat": "inputs.branches"
            },
            {
              "id": "default",
              "type": "source",
              "handleType": "output",
              "label": "{inputs.defaultBranch.label}",
              "visible": "{inputs.branches.length === 0 || inputs.defaultBranch.enabled !== false}"
            },
            {
              "id": "error",
              "label": "Error",
              "type": "source",
              "handleType": "output",
              "visible": "{inputs.errorHandlingEnabled}",
              "constraints": {
                "maxConnections": 1
              }
            }
          ],
          "visible": true
        }
      ],
      "debug": {
        "runtime": "bpmnEngine"
      },
      "model": {
        "type": "bpmn:ServiceTask",
        "serviceType": "Intsvc.UnifiedHttpRequest",
        "context": [
          {
            "name": "connectorKey",
            "type": "string",
            "value": "uipath-uipath-http"
          },
          {
            "name": "objectName",
            "type": "string",
            "value": "http-request"
          },
          {
            "name": "connection",
            "type": "string",
            "value": "<bindings.uipath-uipath-http connection>"
          },
          {
            "name": "folderKey",
            "type": "string",
            "value": "<bindings.FolderKey>"
          },
          {
            "name": "activityConfigurationVersion",
            "type": "string",
            "value": "v1"
          },
          {
            "name": "metadata",
            "body": {
              "telemetryData": {
                "connectorKey": "uipath-uipath-http",
                "connectorName": "HTTP Request"
              },
              "inputMetadata": {},
              "errorState": {
                "hasError": true
              }
            },
            "type": "json"
          }
        ],
        "expansion": {
          "processLevelVariables": [
            {
              "id": "{nodeId}.output",
              "name": "output",
              "type": "jsonSchema",
              "elementId": "{nodeId}",
              "custom": true
            },
            {
              "condition": "hasEdgeFromHandle('error')",
              "id": "{nodeId}.error",
              "name": "error",
              "type": "jsonSchema",
              "elementId": "{nodeId}",
              "custom": true
            }
          ],
          "nodes": [
            {
              "id": "{nodeId}",
              "type": "bpmn:SubProcess",
              "replaceOriginal": true,
              "data": {
                "label": "{node.data.label}",
                "isExpanded": true,
                "model": {
                  "serviceType": "BPMN.Variables",
                  "subprocessVariables": {
                    "inputOutputs": [
                      {
                        "id": "response",
                        "name": "response",
                        "type": "jsonSchema",
                        "variableType": "inputOutput"
                      },
                      {
                        "id": "error",
                        "name": "error",
                        "type": "jsonSchema",
                        "variableType": "inputOutput"
                      }
                    ]
                  },
                  "outputs": [
                    {
                      "name": "output",
                      "type": "jsonSchema",
                      "source": "=vars.response",
                      "var": "{nodeId}.output",
                      "custom": true
                    },
                    {
                      "name": "error",
                      "type": "jsonSchema",
                      "source": "=vars.error",
                      "var": "{nodeId}.error",
                      "custom": true
                    }
                  ]
                }
              },
              "nodes": [
                {
                  "id": "_Implicit_StartEvent_{nodeId}",
                  "type": "bpmn:StartEvent",
                  "parentId": "{nodeId}",
                  "position": {
                    "x": 0,
                    "y": 0
                  },
                  "data": {
                    "label": "HTTP Request Start"
                  }
                },
                {
                  "id": "_Implicit_HttpTask_{nodeId}",
                  "type": "bpmn:SendTask",
                  "parentId": "{nodeId}",
                  "position": {
                    "x": 0,
                    "y": 0
                  },
                  "propagate": {
                    "detail": true,
                    "retry": {
                      "condition": "node.data.inputs.retryCount > 0",
                      "maxRetryCount": "node.data.inputs.retryCount",
                      "retryBackoff": "node.data.inputs.timeout",
                      "retryBackoffDefault": "PT1S",
                      "retryAllErrors": "true",
                      "retryBackoffType": "Static"
                    }
                  },
                  "data": {
                    "label": "{node.data.label}",
                    "model": {
                      "serviceType": "Intsvc.UnifiedHttpRequest",
                      "context": [
                        {
                          "name": "connectorKey",
                          "type": "string",
                          "value": "uipath-uipath-http"
                        },
                        {
                          "name": "objectName",
                          "type": "string",
                          "value": "http-request"
                        },
                        {
                          "name": "connection",
                          "type": "string",
                          "value": "<bindings.uipath-uipath-http connection>"
                        },
                        {
                          "name": "folderKey",
                          "type": "string",
                          "value": "<bindings.FolderKey>"
                        },
                        {
                          "name": "activityConfigurationVersion",
                          "type": "string",
                          "value": "v1"
                        },
                        {
                          "name": "metadata",
                          "body": {
                            "telemetryData": {
                              "connectorKey": "uipath-uipath-http",
                              "connectorName": "HTTP Request"
                            },
                            "inputMetadata": {},
                            "errorState": {
                              "hasError": true
                            }
                          },
                          "type": "json"
                        }
                      ],
                      "outputs": [
                        {
                          "name": "response",
                          "type": "json",
                          "source": "=response",
                          "var": "response",
                          "internal": true
                        }
                      ]
                    }
                  }
                },
                {
                  "id": "_Implicit_Gateway_{nodeId}",
                  "type": "bpmn:ExclusiveGateway",
                  "parentId": "{nodeId}",
                  "position": {
                    "x": 0,
                    "y": 0
                  },
                  "condition": "node.data.inputs.branches.length > 0",
                  "data": {
                    "label": "Response branch",
                    "defaultFlowId": "_Implicit_Edge__Implicit_Gateway_{nodeId}__Implicit_EndEvent_Default_{nodeId}"
                  }
                },
                {
                  "forEach": "node.data.inputs.branches",
                  "id": "_Implicit_EndEvent_{branchName}_{nodeId}",
                  "type": "bpmn:EndEvent",
                  "parentId": "{nodeId}",
                  "position": {
                    "x": 0,
                    "y": 0
                  },
                  "data": {
                    "label": "{branch.name}"
                  }
                },
                {
                  "id": "_Implicit_EndEvent_Default_{nodeId}",
                  "type": "bpmn:EndEvent",
                  "parentId": "{nodeId}",
                  "position": {
                    "x": 0,
                    "y": 0
                  },
                  "data": {
                    "label": "{defaultBranchLabel}"
                  }
                },
                {
                  "condition": "hasEdgeFromHandle('error')",
                  "id": "_Implicit_EndEvent_Failure_{nodeId}",
                  "type": "bpmn:EndEvent",
                  "parentId": "{nodeId}",
                  "position": {
                    "x": 0,
                    "y": 0
                  },
                  "data": {
                    "label": "Failure",
                    "model": {
                      "serviceType": "BPMN.Variables",
                      "outputs": [
                        {
                          "name": "error",
                          "type": "boolean",
                          "source": "=true",
                          "var": "error",
                          "internal": true
                        }
                      ]
                    }
                  }
                },
                {
                  "condition": "hasEdgeFromHandle('error')",
                  "id": "_Implicit_BoundaryError_{nodeId}",
                  "type": "bpmn:BoundaryEvent",
                  "parentId": "{nodeId}",
                  "position": {
                    "x": 0,
                    "y": 0
                  },
                  "data": {
                    "label": "Error",
                    "cancelActivity": false,
                    "attachedToId": "_Implicit_HttpTask_{nodeId}",
                    "eventDefinition": {
                      "type": "bpmn:ErrorEventDefinition",
                      "id": "_Implicit_BoundaryError_{nodeId}_Error"
                    },
                    "model": {
                      "outputs": [
                        {
                          "name": "Error",
                          "type": "jsonSchema",
                          "source": "=Error",
                          "var": "response",
                          "internal": true
                        }
                      ]
                    }
                  }
                }
              ],
              "edges": [
                {
                  "id": "_Implicit_Edge__Implicit_StartEvent_{nodeId}__Implicit_HttpTask_{nodeId}",
                  "source": "_Implicit_StartEvent_{nodeId}",
                  "target": "_Implicit_HttpTask_{nodeId}",
                  "type": "bpmn:SequenceFlow",
                  "data": {}
                },
                {
                  "condition": "node.data.inputs.branches.length === 0",
                  "id": "_Implicit_Edge__Implicit_HttpTask_{nodeId}__Implicit_EndEvent_Default_{nodeId}",
                  "source": "_Implicit_HttpTask_{nodeId}",
                  "target": "_Implicit_EndEvent_Default_{nodeId}",
                  "type": "bpmn:SequenceFlow",
                  "data": {}
                },
                {
                  "condition": "node.data.inputs.branches.length > 0",
                  "id": "_Implicit_Edge__Implicit_HttpTask_{nodeId}__Implicit_Gateway_{nodeId}",
                  "source": "_Implicit_HttpTask_{nodeId}",
                  "target": "_Implicit_Gateway_{nodeId}",
                  "type": "bpmn:SequenceFlow",
                  "data": {}
                },
                {
                  "forEach": "node.data.inputs.branches",
                  "condition": "node.data.inputs.branches.length > 0",
                  "id": "_Implicit_Edge__Implicit_Gateway_{nodeId}__Implicit_EndEvent_{branchName}_{nodeId}",
                  "source": "_Implicit_Gateway_{nodeId}",
                  "target": "_Implicit_EndEvent_{branchName}_{nodeId}",
                  "type": "bpmn:SequenceFlow",
                  "data": {
                    "conditionExpression": "{branch.conditionExpression}",
                    "label": "{branch.name}"
                  }
                },
                {
                  "condition": "node.data.inputs.branches.length > 0",
                  "id": "_Implicit_Edge__Implicit_Gateway_{nodeId}__Implicit_EndEvent_Default_{nodeId}",
                  "source": "_Implicit_Gateway_{nodeId}",
                  "target": "_Implicit_EndEvent_Default_{nodeId}",
                  "type": "bpmn:SequenceFlow",
                  "data": {
                    "label": "{defaultBranchLabel}"
                  }
                },
                {
                  "condition": "hasEdgeFromHandle('error')",
                  "id": "_Implicit_Edge__Implicit_BoundaryError_{nodeId}__Implicit_EndEvent_Failure_{nodeId}",
                  "source": "_Implicit_BoundaryError_{nodeId}",
                  "target": "_Implicit_EndEvent_Failure_{nodeId}",
                  "type": "bpmn:SequenceFlow",
                  "data": {}
                }
              ]
            },
            {
              "id": "_Implicit_PostSubprocessGateway_{nodeId}",
              "type": "bpmn:ExclusiveGateway",
              "condition": "(node.data.inputs.branches.length > 0 || hasEdgeFromHandle('error')) && originalEdges.length > 0",
              "parentId": null,
              "position": {
                "x": 0,
                "y": 0
              },
              "data": {
                "label": "Post-Subprocess Branch"
              }
            }
          ],
          "edges": [
            {
              "condition": "(node.data.inputs.branches.length > 0 || hasEdgeFromHandle('error')) && originalEdges.length > 0",
              "id": "_Implicit_Edge_{nodeId}__Implicit_PostSubprocessGateway_{nodeId}",
              "source": "{nodeId}",
              "target": "_Implicit_PostSubprocessGateway_{nodeId}",
              "type": "bpmn:SequenceFlow",
              "data": {}
            },
            {
              "forEach": "node.data.inputs.branches",
              "condition": "node.data.inputs.branches.length > 0",
              "matchOriginalEdgeByHandle": "branch-{branch.id}",
              "preserveEdgeId": true,
              "source": "_Implicit_PostSubprocessGateway_{nodeId}",
              "type": "bpmn:SequenceFlow",
              "data": {
                "conditionExpression": "{branch.conditionExpression}",
                "label": "{branch.name}"
              }
            },
            {
              "condition": "node.data.inputs.branches.length > 0 || hasEdgeFromHandle('error')",
              "matchOriginalEdgeByHandle": "default",
              "preserveEdgeId": true,
              "source": "_Implicit_PostSubprocessGateway_{nodeId}",
              "type": "bpmn:SequenceFlow",
              "data": {
                "label": "{defaultBranchLabel}"
              }
            },
            {
              "condition": "hasEdgeFromHandle('error')",
              "matchOriginalEdgeByHandle": "error",
              "preserveEdgeId": true,
              "source": "_Implicit_PostSubprocessGateway_{nodeId}",
              "type": "bpmn:SequenceFlow",
              "data": {
                "conditionExpression": "=js:vars.{nodeId}.error || vars.{nodeId}.output?.statusCode >= 400",
                "label": "Error"
              }
            },
            {
              "condition": "node.data.inputs.branches.length === 0 && !hasEdgeFromHandle('error')",
              "matchOriginalEdgeByHandle": "default",
              "preserveEdgeId": true,
              "source": "{nodeId}",
              "type": "bpmn:SequenceFlow"
            }
          ]
        }
      },
      "inputDefinition": {
        "type": "object",
        "properties": {
          "branches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "conditionExpression": {
                  "type": "string"
                }
              }
            }
          },
          "defaultBranch": {
            "type": "object",
            "properties": {
              "enabled": {
                "type": "boolean"
              },
              "label": {
                "type": "string"
              }
            }
          },
          "timeout": {
            "type": "string",
            "pattern": "^P(?!$)(\\d+Y)?(\\d+M)?(\\d+W)?(\\d+D)?(T(?=\\d)(\\d+H)?(\\d+M)?(\\d+S)?)?$",
            "errorMessage": {
              "pattern": "Timeout must be in ISO 8601 duration format (e.g., PT15M, PT1H, P1D)"
            }
          },
          "retryCount": {
            "type": "number"
          }
        }
      },
      "inputDefaults": {
        "branches": [],
        "defaultBranch": {
          "enabled": true,
          "label": ""
        },
        "timeout": "PT15M",
        "retryCount": 0
      },
      "outputDefinition": {
        "output": {
          "type": "object",
          "description": "HTTP response object",
          "source": "=response",
          "var": "output",
          "schema": {
            "type": "object",
            "properties": {
              "code": {
                "type": "integer",
                "description": "HTTP status code"
              },
              "headers": {
                "type": "object",
                "description": "Response headers"
              },
              "body": {
                "description": "Response body"
              }
            }
          }
        },
        "error": {
