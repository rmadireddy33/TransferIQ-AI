        "icon": "https://cloud.uipath.com/elements_/scaleunit_/58cb4f17-4581-4130-a2ae-52448b37dc03/v3/element/elements/uipath-uipath-http/image"
      },
      "inputs": {
        "branches": [],
        "timeout": "PT30S",
        "retryCount": 1,
        "detail": {
          "connector": "uipath-uipath-http",
          "connectionId": "ImplicitConnection",
          "connectionResourceId": null,
          "connectionFolderKey": null,
          "method": "POST",
          "endpoint": "/http-request",
          "bodyParameters": {
            "authentication": "manual",
            "method": "GET",
            "url": "=js:$vars.backendBaseUrl + '/api/transfers/' + encodeURIComponent($vars.ValidateInput.output.transferId)",
            "headers": {
              "Accept": "application/json",
              "X-Correlation-ID": "=js:$vars.ValidateInput.output.correlationId"
