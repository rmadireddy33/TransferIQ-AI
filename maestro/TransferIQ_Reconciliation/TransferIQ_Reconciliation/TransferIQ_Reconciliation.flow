    {
      "id": "ValidateReviewResult",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "ValidateReviewResult",
        "icon": "code"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "inputs": {
        "script": "const body = name => {\n  const response = Reflect.get($vars,name)?.output;\n  if ((response?.code ?? response?.statusCode) !== 200 || !response.body) throw new Error('REVIEW_READ_FAILED');\n  return response.body;\n};\nconst p = body('ReadResolutionPlan'), r = body('ReadLatestReconciliation');\nconst report = body('VerifyDemoDisposition'), audit = body('ReadReviewAudit');\nconst before = $vars.ValidateResolutionPlan.output, decision = $vars.reviewDecision;\nconst original = $vars.RunReconciliation.output.body;\nconst canonical = x => Array.isArray(x) ? x.map(canonical) : x && typeof x === 'object' ?\n  Object.fromEntries(Object.keys(x).sort().map(k=>[k,canonical(x[k])])) : x;\nconst same = (a,b) => JSON.stringify(canonical(a)) === JSON.stringify(canonical(b));\nconst sorted = xs => [...xs].sort((a,b)=>a.exceptionId.localeCompare(b.exceptionId));\nconst outcomes = {APPROVE:'REVIEWED_WITH_OPEN_EXCEPTIONS',REQUEST_EVIDENCE:'EVIDENCE_REQUESTED',ESCALATE:'ESCALATED',REJECT:'REVIEW_REJECTED'};\nconst statuses = {ACCEPT_VERIFIED_EXPLANATION:'ACKNOWLEDGED',REQUEST_ADDITIONAL_EVIDENCE:'EVIDENCE_REQUESTED',ESCALATE_TO_TRANSFER_OPERATIONS:'OPEN_ESCALATED',OPEN_COST_BASIS_CASE:'OPEN_BASIS_CASE'};\nconst expected = decision.reviewOutcome === 'REJECT' ? [] : before.proposedActions.map(a => {\n  const action = {REQUEST_EVIDENCE:'REQUEST_ADDITIONAL_EVIDENCE',ESCALATE:'ESCALATE_TO_TRANSFER_OPERATIONS'}[decision.reviewOutcome] || a.disposition;\n  return {exceptionId:a.exceptionId,disposition:action,status:statuses[action]};\n});\nconst finalStatus = decision.reviewOutcome === 'REJECT' ? 'REJECTED' : 'EXECUTED';\nif (p.planId !== before.planId || p.planHash !== before.planHash || p.planVersion !== before.planVersion || p.status !== finalStatus ||\n    !p.decision || !Object.keys(decision).filter(k=>!['planVersion','planHash'].includes(k)).every(k=>p.decision[k] === decision[k]) ||\n    r.transferId !== original.transferId || r.reconciliationRunId !== original.reconciliationRunId || r.inputFingerprint !== original.inputFingerprint ||\n    !same(sorted(r.exceptions),sorted(original.exceptions)) ||\n    report.planId !== before.planId || report.planStatus !== finalStatus || report.transferId !== before.transferId ||\n    report.reconciliationRunId !== before.reconciliationRunId || report.humanReviewOutcome !== decision.reviewOutcome ||\n    report.workflowOutcome !== outcomes[decision.reviewOutcome] || report.verificationStatus !== 'VERIFIED_DEMO_STATE' ||\n    report.positionsUnchanged !== true || report.transferCompleted !== false || report.demoOnly !== true ||\n    report.identityVerification !== 'UNVERIFIED_DEMO_REFERENCE' || !same(sorted(report.reviewedDispositions),sorted(expected)) ||\n    !same(sorted(report.unresolvedExceptions),sorted(r.exceptions.filter(e=>e.resolutionStatus !== 'EXPLAINED'))) ||\n    audit.planId !== before.planId || !Array.isArray(audit.items) || audit.items.length !== 3 ||\n    !audit.items.every(e=>e.planId === before.planId && e.transferId === before.transferId && report.auditEventIds.includes(e.auditEventId)) ||\n    !['PLAN_PREVIEWED','DEMO_REVIEW_RECORDED',decision.reviewOutcome === 'REJECT' ? 'DEMO_DISPOSITION_REJECTED' : 'DEMO_DISPOSITION_EXECUTED'].every(t=>audit.items.some(e=>e.eventType === t))) {\n  throw new Error('INDEPENDENT_REVIEW_VERIFICATION_FAILED');\n}\nreturn {...report,auditReference:'/api/demo/runs/' + encodeURIComponent($vars.ValidateDemoRun.output.runId) + '/resolution-plans/' + encodeURIComponent(p.planId) + '/audit',\n  correctionsApplied:0, reviewEventReference:decision.reviewEventReference};\n",
        "errorHandlingEnabled": true
      }
    },
    {
      "id": "ValidateReviewResultFailed",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "display": {
        "label": "End",
        "icon": "circle-check"
      },
      "model": {
        "type": "bpmn:EndEvent"
      },
