{
  "id": "fa7de741-ad8f-441f-8f3d-9bf96e5f3497",
  "version": "1.9",
  "name": "TransferIQ_Reconciliation",
  "runtime": "maestro",
  "nodes": [
    {
      "id": "StartTransferInvestigation",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "StartTransferInvestigation",
        "icon": "play"
      },
      "inputs": {
        "entryPointId": "de969c74-0104-400d-8000-df92344f0104",
        "isDefaultEntryPoint": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "uniqueId": "ce36a9fd-dac9-4e89-9750-3a4811c014d5"
    },
    {
      "id": "ValidateInput",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "ValidateInput",
        "icon": "code"
      },
      "inputs": {
        "script": "const portalOutput = $vars.PortalWebhook.output;\nconst isPortal = portalOutput && typeof portalOutput.request_body === 'string';\nconst manualOutput = $vars.StartTransferInvestigation.output;\nlet input;\nif (isPortal) {\n  try { input = JSON.parse(portalOutput.request_body); } catch { throw new Error('INVALID_PORTAL_WEBHOOK_BODY'); }\n  const keys = input && typeof input === 'object' && !Array.isArray(input) ? Object.keys(input).sort() : [];\n  if (JSON.stringify(keys) !== JSON.stringify(['enableIXP','executionRequestId','transferId']) ||\n      !/^TRF-100[1-5]$/.test(input.transferId) || !/^PEX-[0-9a-f]{32}$/.test(input.executionRequestId) ||\n      input.enableIXP !== false) throw new Error('INVALID_PORTAL_WEBHOOK_BODY');\n} else input = manualOutput;\nconst transferId = input?.transferId;\nif (typeof transferId !== 'string' || !/^[A-Za-z0-9_-]{1,64}$/.test(transferId)) throw new Error('INVALID_TRANSFER_INPUT');\nconst executionRequestId = isPortal ? input.executionRequestId : '';\nreturn { transferId, executionRequestId,\n  correlationId: executionRequestId || ('TIQ-' + Date.now() + '-' + Math.random().toString(36).slice(2, 12)),\n  reviewerReference: isPortal ? 'PORTAL_AUTHORIZED_OPERATOR' : input.reviewerReference,\n  enableIXP: isPortal ? false : input.enableIXP === true,\n  corporateActionPdf: isPortal ? null : (input.corporateActionPdf ?? null),\n  entryMode: isPortal ? 'PORTAL_WEBHOOK' : 'MANUAL'\n};\n",
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "properties": {
            "transferId": {
              "type": "string"
            },
            "correlationId": {
              "type": "string"
            },
            "executionRequestId": {
              "type": "string"
            },
            "reviewerReference": {
              "type": "string"
            },
            "enableIXP": {
              "type": "boolean"
            },
            "corporateActionPdf": {
              "type": "object"
            },
            "entryMode": {
              "type": "string"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "601a87be-42d5-47d9-8383-268d294861ad"
    },
