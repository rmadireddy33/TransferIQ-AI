    {
      "id": "ValidateResolutionPlan",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "ValidateResolutionPlan",
        "icon": "code"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output",
          "properties": {
            "contractVersion": {
              "type": "string"
            },
            "demoOnly": {
              "type": "boolean"
            },
            "identityVerification": {
              "type": "string"
            },
            "planId": {
              "type": "string"
            },
            "transferId": {
              "type": "string"
            },
            "reconciliationRunId": {
              "type": "string"
            },
            "planVersion": {
              "type": "number"
            },
            "planHash": {
              "type": "string"
            },
            "status": {
              "type": "string"
            },
            "proposedActions": {
              "type": "array"
            },
            "evidenceReferences": {
              "type": "array"
            },
            "investigationSummary": {
              "type": "string"
            },
            "overallRiskLevel": {
              "type": "string"
            },
            "clientReference": {
              "type": "string"
            },
            "documentEvidenceStatus": {
              "type": "string"
            },
            "expiresAt": {
              "type": "number"
            },
            "decision": {
              "type": "object"
            },
            "exceptionCount": {
              "type": "string"
            },
            "corporateActionExplanation": {
              "type": "string"
            },
            "shortageExplanation": {
              "type": "string"
            },
            "evidenceDisplay": {
              "type": "string"
            },
            "dispositionDisplay": {
              "type": "string"
            },
            "demoNotice": {
              "type": "string"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "inputs": {
        "script": "const response = $vars.PreviewResolutionPlan.output;\nconst p = response?.body;\nconst expected = $vars.BuildResolutionPlan.output;\nconst canonical = x => Array.isArray(x) ? x.map(canonical) : x && typeof x === 'object' ?\n  Object.fromEntries(Object.keys(x).sort().map(k=>[k,canonical(x[k])])) : x;\nconst same = (a,b) => JSON.stringify(canonical(a)) === JSON.stringify(canonical(b));\nif (!response || (Reflect.get(response,'code') ?? Reflect.get(response,'statusCode')) !== 200 || !p || p.contractVersion !== '1.0' ||\n    p.demoOnly !== true || p.identityVerification !== 'UNVERIFIED_DEMO_REFERENCE' || p.status !== 'PREVIEWED' ||\n    !/^PLAN-[0-9a-f-]{36}$/.test(p.planId) || p.planVersion !== 1 || !/^[0-9a-f]{64}$/.test(p.planHash) ||\n    p.transferId !== expected.transferId || p.reconciliationRunId !== expected.reconciliationRunId ||\n    p.investigationSummary !== expected.investigationSummary || p.overallRiskLevel !== expected.overallRiskLevel ||\n    p.documentEvidenceStatus !== expected.documentEvidenceStatus || !same(p.proposedActions,expected.proposedActions) ||\n    typeof p.expiresAt !== 'number' || p.expiresAt * 1000 <= Date.now() ||\n    !same(p.evidenceReferences,[...new Set(expected.proposedActions.flatMap(a=>a.evidenceReferences))].sort())) {\n  throw new Error('INVALID_RESOLUTION_PLAN');\n}\nconst exceptions = $vars.NormalizeReconciliation.output.exceptions;\nconst describe = security => {\n  const e = exceptions.find(e => e.securityId === security);\n  return e ? JSON.stringify({securityId:e.securityId,status:e.resolutionStatus,description:e.description,\n    sourceQuantity:e.sourceQuantity,targetQuantity:e.targetQuantity,expectedQuantity:e.expectedQuantity,\n    difference:e.difference,evidenceReferences:e.evidenceReferences}) : 'Not applicable to this transfer';\n};\nreturn {...p,exceptionCount:String(exceptions.length),corporateActionExplanation:describe('SEC-103'),\n  shortageExplanation:describe('SEC-104'),evidenceDisplay:JSON.stringify(p.evidenceReferences),\n  dispositionDisplay:JSON.stringify(p.proposedActions),\n  demoNotice:'Fictional, isolated review. No custody or staging changes. Review identity is an unverified demo reference. Shortages remain unresolved.'};\n",
        "errorHandlingEnabled": true
      }
    },
    {
