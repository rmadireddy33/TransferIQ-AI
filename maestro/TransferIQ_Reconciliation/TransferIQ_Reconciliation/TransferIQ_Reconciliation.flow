  "nodes": [
    {
      "id": "StartTransferInvestigation",
      "type": "core.trigger.manual",
      "typeVersion": "1.0",
      "display": {
        "label": "StartTransferInvestigation",
        "icon": "play"
      },
      "inputs": {
        "entryPointId": "59339fa7-1f50-422d-b70c-5c45498d590b"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Data passed when manually triggering the workflow.",
          "source": "null",
          "var": "output"
        }
      },
      "uniqueId": "e4d21456-9d5d-4328-9723-eca67a3b0294"
    },
    {
      "id": "ValidateInput",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "ValidateInput",
        "icon": "code"
      },
      "inputs": {
        "script": "const transferId = $vars.StartTransferInvestigation.output.transferId;\nif (typeof transferId !== 'string' || !/^[A-Za-z0-9_-]{1,64}$/.test(transferId)) throw new Error('INVALID_TRANSFER_INPUT');\nreturn { transferId, correlationId: 'TIQ-' + Date.now() + '-' + Math.random().toString(36).slice(2, 12) };\n",
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "properties": {
            "transferId": {
              "type": "string"
            },
            "correlationId": {
              "type": "string"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "7febf81f-c824-40a9-841c-5b870a8c3779"
    },
    {
      "id": "InvalidInput",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End",
