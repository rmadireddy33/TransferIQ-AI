        "result": {
          "type": "object",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "Object.assign(({\n      transferId: Reflect.get($vars, \"ValidateInput\")?.output?.transferId || Reflect.get($vars, \"StartTransferInvestigation\")?.output?.transferId || null,\n      reconciliationRunId: null, totalPositions: null, directlyMatched: null,\n      evidenceExplained: null, unresolvedCount: null, costBasisIssues: null,\n      exceptions: [], evidenceReferences: [], workflowOutcome: 'FAILED',\n      correlation: { transferId: Reflect.get($vars, \"ValidateInput\")?.output?.transferId || Reflect.get($vars, \"StartTransferInvestigation\")?.output?.transferId || null, failedStep: \"RunReconciliation\" },\n      error: { code: \"HTTP_REQUEST_FAILED\", summary: \"Backend request failed: check HTTP status, availability, authentication and timeout.\" }\n    }), { httpStatus: (() => {\n        const node = Reflect.get($vars, \"RunReconciliation\");\n        const status = node?.error?.status ?? (node && Reflect.get(node, 'output'))?.status;\n        return Number.isInteger(status) && status >= 100 && status <= 599 ? status : null;\n      })() })",
            "fieldType": "object"
          },
          "var": "result"
        },
        "backendBaseUrl": {
          "type": "string",
          "description": "",
