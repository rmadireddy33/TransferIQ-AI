          "type": "boolean",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "$vars.backendConnectionConfigured",
            "fieldType": "boolean"
          },
          "var": "backendConnectionConfigured"
        }
      },
      "uniqueId": "70adbbcf-5e65-48a8-933b-15fedee3203a"
    },
    {
      "id": "BackendConfigured",
      "type": "core.logic.decision",
      "typeVersion": "1.3",
      "display": {
        "label": "BackendConfigured",
        "icon": "trending-up-down"
      },
      "inputs": {
        "trueLabel": "Secure HTTP connection configured",
        "falseLabel": "Configuration required",
        "expression": "$vars.backendConnectionConfigured"
      },
      "uniqueId": "27609695-fdca-4d55-be05-8ba630de80fd"
    },
    {
      "id": "ValidateBackendConfiguration",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "ValidateBackendConfiguration",
        "icon": "code"
      },
      "inputs": {
        "script": "if (typeof $vars.backendBaseUrl !== 'string' || !/^https:\\/\\//.test($vars.backendBaseUrl)) throw new Error('INVALID_CONFIGURATION'); return true;",
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "boolean",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "dd0731a6-3f87-46e0-ae15-5f186e97a884"
    },
