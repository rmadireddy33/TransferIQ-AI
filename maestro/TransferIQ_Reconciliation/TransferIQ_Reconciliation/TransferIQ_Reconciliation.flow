            "expression": "({\n  ...$vars.NormalizeReconciliation.output, workflowOutcome: 'INVESTIGATION_REVIEW_REQUIRED', documentEvidenceStatus: 'IXP_SETUP_OR_EVIDENCE_REQUIRED', humanReviewRequired: true, evidenceOutcome: \"EVIDENCE_REVIEW_REQUIRED\",\n  extractionResult: {\n    transferId: $vars.NormalizeReconciliation.output.transferId,\n    documentType: 'CORPORATE_ACTION_NOTICE', extractedFields: {}, evidenceReference: null,\n    validationStatus: 'REVIEW_REQUIRED', discrepancies: [\"IXP_EXTRACTION_FAILED_OR_NOT_CONFIGURED\"], extractionStatus: 'EXTRACTION_FAILED'\n  }\n})",
            "fieldType": "object"
          },
          "var": "result"
        },
        "backendBaseUrl": {
          "type": "string",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "$vars.backendBaseUrl",
            "fieldType": "string"
          },
