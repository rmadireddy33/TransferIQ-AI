    {
      "id": "ValidateReceivingPositions",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "ValidateReceivingPositions",
        "icon": "code"
      },
      "inputs": {
        "script": "const response = $vars.GetReceivingPositions.output;\nconst httpStatus = response && (Reflect.get(response, 'code') ?? Reflect.get(response, 'statusCode'));\nconst page = response && response.body;\nif (!response || httpStatus !== 200 || !page || !Array.isArray(page.items) ||\n    !Number.isSafeInteger(page.total) || page.total < 0 || page.total !== page.items.length || page.offset !== 0 || page.limit !== 100 ||\n    page.positionKind !== 'RECEIVING_TRANSFER_STAGING' || page.settledHoldings !== false ||\n    !page.items.every(p => p && typeof p.stagingPositionId === 'string' && typeof p.securityId === 'string' &&\n      p.transferId === $vars.ValidateInput.output.transferId && typeof p.quantity === 'string' && /^\\d+(\\.\\d+)?$/.test(p.quantity) &&\n      Number.isSafeInteger(p.version) && p.version >= 1 && typeof p.status === 'string')) throw new Error('INVALID_RESPONSE');\n// Empty staging is evidence: the backend must classify missing securities.\nreturn page;\n",
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
