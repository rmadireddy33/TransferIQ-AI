    {
      "id": "RequestEvidence",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "RequestEvidence",
        "icon": "code"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "inputs": {
        "script": "// Reached only through the corresponding real Quick Form outcome port.\nconst form = $vars.TransferOperationsReview.output;\nconst outcome = 'REQUEST_EVIDENCE';\nconst label = {APPROVE:'Approve Disposition',REQUEST_EVIDENCE:'Request Evidence',ESCALATE:'Escalate',REJECT:'Reject'}[outcome];\nif (!form || typeof form !== 'object' || form.Action !== label) throw new Error('MISSING_OR_MISMATCHED_HUMAN_FORM_OUTPUT');\nconst value = key => {\n  const result = form[key] ?? '';\n  if (typeof result !== 'string' || result.length > 2000) throw new Error('INVALID_REVIEW_TEXT');\n  return result;\n};\nconst plan = $vars.ValidateResolutionPlan.output;\nreturn {planVersion:plan.planVersion,planHash:plan.planHash,reviewOutcome:outcome,\n  reviewerReference:$vars.StartTransferInvestigation.output.reviewerReference,\n  reviewerComments:value('reviewerComments'),additionalInformation:value('additionalInformation'),\n  // Correlation reference, NOT a claimed verified Action Center task ID.\n  reviewEventReference:$vars.ValidateInput.output.correlationId + ':TransferOperationsReview'};\n",
        "errorHandlingEnabled": true
      }
    },
