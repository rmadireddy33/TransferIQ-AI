          "var": "reviewDecision"
        }
      },
      "uniqueId": "c5d9c3e3-a610-448a-8ff5-eef17929f3a9"
    },
    {
      "id": "ApproveDisposition",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "ApproveDisposition",
        "icon": "code"
      },
      "inputs": {
        "script": "// Reached only through the corresponding real Quick Form outcome port.\r\nconst form = $vars.quickForm1.output;\r\nconst outcome = 'APPROVE';\r\nconst label = {APPROVE:'Approve',REQUEST_EVIDENCE:'Request Evidence',ESCALATE:'Escalate',REJECT:'Reject'}[outcome];\r\nif (!form || typeof form !== 'object' || form.Action !== label) throw new Error('MISSING_OR_MISMATCHED_HUMAN_FORM_OUTPUT');\r\nconst value = key => {\r\n  // Use the saved Studio field ID; older task field names remain validated aliases.\r\n  const result = key === 'reviewerComments' ? (Reflect.get(form, 'reviewerCommentsOptional') ?? Reflect.get(form, 'Reviewer comments (optional)') ?? Reflect.get(form, 'comments') ?? Reflect.get(form, 'reviewerComments') ?? '') : (Reflect.get(form, key) ?? '');\r\n  if (typeof result !== 'string' || result.length > 2000) throw new Error('INVALID_REVIEW_TEXT');\r\n  return result;\r\n};\r\nconst plan = $vars.ValidateResolutionPlan.output;\r\nreturn {planVersion:plan.planVersion,planHash:plan.planHash,reviewOutcome:outcome,\r\n  reviewerReference:$vars.ValidateInput.output.reviewerReference,\r\n  reviewerComments:value('reviewerComments'),additionalInformation:value('additionalInformation'),\r\n  // Correlation reference, NOT a claimed verified Action Center task ID.\r\n  reviewEventReference:$vars.ValidateInput.output.correlationId + ':TransferOperationsReview'};\r\n",
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "97c8cec0-429b-457d-bdc1-31cb87f12542"
    },
    {
      "id": "ApproveDispositionFailed",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End",
        "icon": "circle-check"
      },
      "inputs": {},
      "outputs": {
        "result": {
          "type": "object",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "({\n  ...$vars.ValidateInvestigation.output, workflowOutcome:'REVIEW_FAILED', verificationStatus:'NOT_VERIFIED',\n  planId:(() => {const n=Reflect.get($vars,'ValidateResolutionPlan');return n && Reflect.get(n,'output')?.planId || null;})(), planStatus:null,\n  humanReviewOutcome:null, reviewedDispositions:[], auditReference:null,\n  demoOnly:true, identityVerification:'UNVERIFIED_DEMO_REFERENCE', error:{code:'REVIEW_STEP_FAILED',failedStep:\"ApproveDisposition\"}\n})",
            "fieldType": "object"
          },
          "var": "result"
        },
        "backendBaseUrl": {
          "type": "string",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "$vars.backendBaseUrl",
            "fieldType": "string"
          },
          "var": "backendBaseUrl"
        },
        "reviewDecision": {
          "type": "object",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "$vars.reviewDecision",
            "fieldType": "object"
          },
          "var": "reviewDecision"
        }
      },
      "uniqueId": "218bb6ed-a54d-4344-8960-e3d9955725ce"
    },
