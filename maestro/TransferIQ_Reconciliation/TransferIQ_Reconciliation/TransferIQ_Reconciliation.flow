                      },
                      {
                        "id": "error",
                        "name": "error",
                        "type": "jsonSchema",
                        "variableType": "inputOutput"
                      }
                    ]
                  },
                  "outputs": [
                    {
                      "name": "output",
                      "type": "jsonSchema",
