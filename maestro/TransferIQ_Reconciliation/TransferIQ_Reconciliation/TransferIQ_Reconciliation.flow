    {
      "id": "PrepareInvestigationContext",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "PrepareInvestigationContext",
        "icon": "code"
      },
      "inputs": {
        "script": "// Evidence assembly only. No financial arithmetic, extraction or AI simulation.\nconst n = $vars.NormalizeReconciliation.output;\nconst r = $vars.RunReconciliation.output.body;\nconst object = x => x && typeof x === 'object' && !Array.isArray(x);\nconst text = x => typeof x === 'string' && x.length > 0;\nif (!['INVESTIGATION_REQUIRED', 'CLEAN'].includes(n.workflowOutcome) ||\n    r.status !== 'EXCEPTIONS_DETECTED' || !r.exceptions.length) throw new Error('INVALID_INVESTIGATION_CONTEXT');\nconst missingEvidence = [];\nconst response = name => Reflect.get($vars, name)?.output;\nconst ca = response('GetCorporateActionReference');\nconst refs = response('GetInvestigationReferences');\nconst scoped = x => object(x) && x.transferId === n.transferId && x.runId === n.demoRunId && x.fictionalDemo === true;\nconst ok = x => (x?.code ?? x?.statusCode) === 200;\nlet corporateActions = [], securities = [], identifierMappings = [], costBasis = [];\nconst securityIds = new Set(r.positions.map(p => p.securityId));\nif (ok(ca) && scoped(ca.body) && Array.isArray(ca.body.items) && ca.body.total === ca.body.items.length && ca.body.offset === 0 &&\n    ca.body.items.every(a => object(a) && securityIds.has(a.securityId) && text(a.corporateActionId) && typeof a.verified === 'boolean')) {\n  corporateActions = ca.body.items;\n} else missingEvidence.push({ source: 'corporate-actions', code: 'REFERENCE_UNAVAILABLE_OR_INVALID', httpStatus: ca?.code ?? ca?.statusCode ?? null });\nif (ok(refs) && scoped(refs.body) && refs.body.contractVersion === '1.0' &&\n    Array.isArray(refs.body.securities) && Array.isArray(refs.body.identifierMappings) && Array.isArray(refs.body.costBasis) &&\n    refs.body.securities.every(s => object(s) && securityIds.has(s.securityId)) &&\n    refs.body.identifierMappings.every(m => object(m) && securityIds.has(m.canonicalSecurityId) && typeof m.verified === 'boolean') &&\n    refs.body.costBasis.every(b => object(b) && b.transferId === n.transferId && securityIds.has(b.securityId))) {\n  ({ securities, identifierMappings, costBasis } = refs.body);\n} else missingEvidence.push({ source: 'investigation-references', code: 'REFERENCE_UNAVAILABLE_OR_INVALID', httpStatus: refs?.code ?? refs?.statusCode ?? null });\n// Index actual record IDs and actual evidence references, scoped by security.\nconst evidenceRecords = [];\nconst add = (id, securityId, kind, verified) => {\n  if (text(id)) evidenceRecords.push({ evidenceId: id, securityId, kind, verified });\n};\nfor (const p of n.sourcePositions) add(p.positionId, p.securityId, 'SOURCE_POSITION', true);\nfor (const p of n.receivingStagingPositions) add(p.stagingPositionId, p.securityId, 'RECEIVING_STAGING', true);\nfor (const e of r.exceptions) add(e.exceptionId, e.securityId, 'RECONCILIATION_EXCEPTION', true);\nfor (const a of corporateActions) {\n  add(a.corporateActionId, a.securityId, 'CORPORATE_ACTION', a.verified);\n  add(a.evidenceReference, a.securityId, 'CORPORATE_ACTION', a.verified);\n}\nfor (const m of identifierMappings) {\n  add(m.mappingId, m.canonicalSecurityId, 'IDENTIFIER_MAPPING', m.verified);\n  add(m.evidenceReference, m.canonicalSecurityId, 'IDENTIFIER_MAPPING', m.verified);\n}\nfor (const b of costBasis) {\n  add(b.costBasisId, b.securityId, 'COST_BASIS', b.status === 'COMPLETE');\n  add(b.evidenceReference, b.securityId, 'COST_BASIS', b.status === 'COMPLETE');\n}\nconst enabled = $vars.ValidateInput.output.enableIXP === true;\nconst verifiedDocument = enabled ? response('ValidateCorporateAction')?.extractionResult : null;\nif (enabled && verifiedDocument?.validationStatus !== 'VERIFIED') throw new Error('DOCUMENT_EVIDENCE_NOT_VERIFIED');\nreturn {\n  contractVersion: '1.0', transferId: n.transferId, reconciliationRunId: n.reconciliationRunId,\n  transfer: $vars.ValidateTransfer.output, deliveringPositions: n.sourcePositions,\n  receivingStagingPositions: n.receivingStagingPositions,\n  reconciliation: r, reconciliationSummary: r.summary, exceptions: r.exceptions,\n  securityIdentifiers: Array.from(securityIds).map(securityId => ({ securityId,\n    observedIdentifiers: Array.from(new Set([...n.sourcePositions, ...n.receivingStagingPositions]\n      .filter(p => p.securityId === securityId).map(p => p.observedIdentifier).filter(text))) })),\n  securities, corporateActions, identifierMappings, costBasis,\n  costBasisExceptions: n.costBasisExceptions, evidenceRecords, evidenceReferences: n.evidenceReferences,\n  missingEvidence, verifiedDocumentEvidence: verifiedDocument,\n  documentEvidenceStatus: enabled ? 'VERIFIED_IXP_EVIDENCE' : 'NOT_PROCESSED_IXP_DISABLED'\n};\n",
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output",
          "properties": {
            "contractVersion": {
              "type": "string"
            },
            "transferId": {
              "type": "string"
            },
            "reconciliationRunId": {
              "type": "string"
            },
            "transfer": {
              "type": "object"
            },
            "deliveringPositions": {
              "type": "array"
            },
            "receivingStagingPositions": {
              "type": "array"
            },
            "reconciliation": {
              "type": "object"
            },
            "reconciliationSummary": {
              "type": "object"
            },
            "exceptions": {
              "type": "array"
            },
            "securityIdentifiers": {
              "type": "array"
            },
            "securities": {
              "type": "array"
            },
            "corporateActions": {
              "type": "array"
            },
            "identifierMappings": {
              "type": "array"
            },
            "costBasis": {
              "type": "array"
            },
            "costBasisExceptions": {
              "type": "array"
            },
            "evidenceRecords": {
              "type": "array"
            },
            "evidenceReferences": {
              "type": "array"
            },
