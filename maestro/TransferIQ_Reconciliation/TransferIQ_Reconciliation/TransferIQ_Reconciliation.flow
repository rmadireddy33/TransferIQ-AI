              "name": "error",
              "type": "jsonSchema",
              "elementId": "PreviewResolutionPlan",
              "custom": true
            }
          ],
          "nodes": [
            {
              "id": "PreviewResolutionPlan",
              "type": "bpmn:SubProcess",
              "replaceOriginal": true,
              "data": {
                "label": "{node.data.label}",
