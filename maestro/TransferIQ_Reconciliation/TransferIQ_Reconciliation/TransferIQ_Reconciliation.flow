    {
      "id": "ValidateInvestigation",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "ValidateInvestigation",
        "icon": "code"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "inputs": {
        "script": "// Treat model output as untrusted data. This validator never authorizes writes.\nconst c = $vars.PrepareInvestigationContext.output;\nconst n = $vars.NormalizeReconciliation.output;\nconst a = $vars.TransferInvestigationAgent.output;\nconst object = x => x && typeof x === 'object' && !Array.isArray(x);\nconst text = x => typeof x === 'string' && x.trim().length > 0 && x.length <= 8000;\nconst list = x => Array.isArray(x) && x.length <= 100;\nconst keys = (x, expected) => object(x) && Object.keys(x).length === expected.length && expected.every(k => Object.prototype.hasOwnProperty.call(x,k));\nconst levels = ['LOW','MEDIUM','HIGH'];\nconst actions = ['ACCEPT_VERIFIED_MATCH','NORMALIZE_COMPARISON','REQUEST_ADDITIONAL_EVIDENCE','INVESTIGATE_POSITION_SHORTAGE','OPEN_COST_BASIS_CASE','ESCALATE_UNSUPPORTED_CHANGE'];\nconst errors = [];\nconst report = (valid) => ({\n  ...n, workflowOutcome: valid && !c.missingEvidence.length && !a.findings.some(f => f.evidenceStatus === 'CONFLICTING') ? 'INVESTIGATION_COMPLETED' : 'INVESTIGATION_REVIEW_REQUIRED',\n  reconciliationOutcome: n.workflowOutcome, documentEvidenceStatus: c.documentEvidenceStatus,\n  investigationStatus: valid ? 'COMPLETED' : 'INVALID_AGENT_OUTPUT',\n  investigationSummary: valid ? a.investigationSummary : 'Agent output failed independent validation; human investigation is required.',\n  overallRiskLevel: valid ? a.overallRiskLevel : null, findings: valid ? a.findings : [],\n  unresolvedQuestions: valid ? a.unresolvedQuestions : [], validationErrors: errors,\n  evidenceRecords: c.evidenceRecords, missingEvidence: c.missingEvidence,\n  unresolvedExceptions: c.exceptions.filter(e => e.resolutionStatus !== 'EXPLAINED'),\n  recommendedNextActions: valid ? [...new Set(a.findings.map(f => f.recommendedAction))] : ['REQUEST_ADDITIONAL_EVIDENCE'],\n  humanReviewRequired: true, correctionsApplied: 0, transferCompleted: false\n});\nif (!keys(a, ['transferId','investigationSummary','overallRiskLevel','findings','unresolvedQuestions','documentEvidenceStatus','requiresHumanReview']) ||\n    a.transferId !== c.transferId || !text(a.investigationSummary) || !levels.includes(a.overallRiskLevel) ||\n    a.documentEvidenceStatus !== c.documentEvidenceStatus || a.requiresHumanReview !== true ||\n    !list(a.unresolvedQuestions) || !a.unresolvedQuestions.every(text) || !list(a.findings) ||\n    a.findings.length !== c.exceptions.length || !a.findings.length) {\n  errors.push('INVALID_REPORT_CONTRACT'); return report(false);\n}\nconst seen = new Set();\nfor (const f of a.findings) {\n  if (!keys(f,['exceptionId','securityId','classification','rootCause','evidenceIds','confidence','evidenceStatus','recommendedAction','requiresHumanReview'])) {\n    errors.push('INVALID_FINDING_CONTRACT'); continue;\n  }\n  const e = c.exceptions.find(e => e.exceptionId === f.exceptionId);\n  if (!e || seen.has(f.exceptionId) || f.securityId !== e.securityId || !c.securityIdentifiers.some(s => s.securityId === f.securityId)) {\n    errors.push('INVALID_EXCEPTION_OR_SECURITY'); continue;\n  }\n  seen.add(f.exceptionId);\n  // Classification is the deterministic backend exception type, never AI reclassification.\n  if (f.classification !== e.exceptionType || !text(f.rootCause) || !levels.includes(f.confidence) ||\n      !['VERIFIED','INCOMPLETE','CONFLICTING'].includes(f.evidenceStatus) || f.requiresHumanReview !== true ||\n      !actions.includes(f.recommendedAction) || !list(f.evidenceIds) || !f.evidenceIds.length ||\n      new Set(f.evidenceIds).size !== f.evidenceIds.length) {\n    errors.push('UNSUPPORTED_FINDING'); continue;\n  }\n  const records = f.evidenceIds.map(id => c.evidenceRecords.filter(r => r.evidenceId === id && r.securityId === f.securityId));\n  if (records.some(matches => !matches.length || matches.some(r => !r.verified))) errors.push('INVALID_EVIDENCE_REFERENCE');\n  const explained = e.resolutionStatus === 'EXPLAINED';\n  const basis = e.exceptionType.startsWith('COST_BASIS_');\n  const supportedReference = records.some(matches => matches.some(r =>\n    ['CORPORATE_ACTION','IDENTIFIER_MAPPING'].includes(r.kind) && r.verified && e.evidenceReferences.includes(r.evidenceId)));\n  if (['ACCEPT_VERIFIED_MATCH','NORMALIZE_COMPARISON'].includes(f.recommendedAction) &&\n      (!explained || !supportedReference || f.evidenceStatus !== 'VERIFIED')) errors.push('UNSUPPORTED_CORRECTIVE_RECOMMENDATION');\n  if (!explained && f.evidenceStatus === 'VERIFIED') errors.push('UNRESOLVED_CAUSE_CANNOT_BE_VERIFIED');\n  if (f.evidenceStatus === 'VERIFIED' && explained && !supportedReference) errors.push('MISSING_INDEPENDENT_REFERENCE');\n  if (f.evidenceStatus === 'CONFLICTING' && !['REQUEST_ADDITIONAL_EVIDENCE','ESCALATE_UNSUPPORTED_CHANGE'].includes(f.recommendedAction)) errors.push('CONFLICT_REQUIRES_REVIEW');\n  if (f.recommendedAction === 'OPEN_COST_BASIS_CASE' && !basis) errors.push('INVALID_COST_BASIS_RECOMMENDATION');\n  if (basis && !['OPEN_COST_BASIS_CASE','REQUEST_ADDITIONAL_EVIDENCE','ESCALATE_UNSUPPORTED_CHANGE'].includes(f.recommendedAction)) errors.push('COST_BASIS_REQUIRES_SEPARATE_CASE');\n  if (f.recommendedAction === 'INVESTIGATE_POSITION_SHORTAGE' && (explained || basis || typeof e.difference !== 'string' || !e.difference.startsWith('-'))) errors.push('NO_BACKEND_SHORTAGE');\n}\nreturn report(errors.length === 0);\n",
        "errorHandlingEnabled": true
      }
    },
    {
      "id": "AgentValidationFailed",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "display": {
        "label": "End",
        "icon": "circle-check"
      },
      "model": {
        "type": "bpmn:EndEvent"
      },
      "inputs": {},
      "outputs": {
        "result": {
          "type": "object",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "({\n  ...$vars.NormalizeReconciliation.output, workflowOutcome: 'INVESTIGATION_REVIEW_REQUIRED',\n  documentEvidenceStatus: $vars.StartTransferInvestigation.output.enableIXP === true ? 'IXP_SETUP_OR_EVIDENCE_REQUIRED' : 'NOT_PROCESSED_IXP_DISABLED',\n  investigationStatus: \"INVALID_AGENT_OUTPUT\", investigationSummary: 'Investigation could not be validated; human review is required.',\n  findings: [], recommendedNextActions: ['REQUEST_ADDITIONAL_EVIDENCE'], humanReviewRequired: true,\n  unresolvedExceptions: $vars.NormalizeReconciliation.output.exceptions.filter(e => e.resolutionStatus !== 'EXPLAINED'),\n  unresolvedQuestions: [],\n  correctionsApplied: 0, transferCompleted: false, error: { code: \"INVALID_AGENT_OUTPUT\", failedStep: \"ValidateInvestigation\" }\n})",
            "fieldType": "object"
          },
          "var": "result"
        },
        "backendBaseUrl": {
          "type": "string",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "$vars.backendBaseUrl",
            "fieldType": "string"
          },
          "var": "backendBaseUrl"
        },
        "reviewDecision": {
          "type": "object",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "$vars.reviewDecision",
            "fieldType": "object"
          },
          "var": "reviewDecision"
        }
      }
    },
    {
      "id": "InvestigationValidated",
      "type": "core.logic.decision",
      "typeVersion": "1.0.0",
      "display": {
        "label": "InvestigationValidated",
        "icon": "trending-up-down"
      },
      "model": {
        "type": "bpmn:InclusiveGateway"
      },
      "inputs": {
        "trueLabel": "Validated investigation",
        "falseLabel": "False",
        "expression": "$vars.ValidateInvestigation.output.workflowOutcome === 'INVESTIGATION_COMPLETED'"
      }
    },
    {
      "id": "InvestigationResult",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "display": {
        "label": "Investigation needs evidence",
        "icon": "circle-check"
      },
      "model": {
        "type": "bpmn:EndEvent"
      },
      "inputs": {},
      "outputs": {
        "result": {
          "type": "object",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "$vars.ValidateInvestigation.output",
            "fieldType": "object"
          },
          "var": "result"
        },
        "backendBaseUrl": {
          "type": "string",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "$vars.backendBaseUrl",
            "fieldType": "string"
          },
          "var": "backendBaseUrl"
        },
        "reviewDecision": {
          "type": "object",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "$vars.reviewDecision",
            "fieldType": "object"
          },
          "var": "reviewDecision"
        }
      }
    },
    {
      "id": "BuildResolutionPlan",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "BuildResolutionPlan",
        "icon": "code"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "inputs": {
        "script": "const report = $vars.ValidateInvestigation.output;\nconst reconciliation = $vars.NormalizeReconciliation.output;\nconst reviewer = $vars.StartTransferInvestigation.output.reviewerReference;\nif (report.workflowOutcome !== 'INVESTIGATION_COMPLETED' || report.investigationStatus !== 'COMPLETED' ||\n    report.documentEvidenceStatus !== 'NOT_PROCESSED_IXP_DISABLED' ||\n    typeof reviewer !== 'string' || !reviewer.trim() || reviewer.length > 256 ||\n    !/^[A-Za-z0-9_-]{43}$/.test($vars.CreateDemoRun.output.body.reviewCapability)) {\n  throw new Error('REVIEW_CONFIGURATION_OR_VALIDATION_REQUIRED');\n}\n// Agent prose cannot choose an authorized action. Use immutable backend exceptions.\nreturn {\n  transferId:reconciliation.transferId, reconciliationRunId:reconciliation.reconciliationRunId,\n  agentInvestigationId:$vars.ValidateInput.output.correlationId + ':TransferInvestigationAgent',\n  investigationSummary:report.investigationSummary, overallRiskLevel:report.overallRiskLevel,\n  documentEvidenceStatus:report.documentEvidenceStatus,\n  proposedActions:reconciliation.exceptions.map(e => ({exceptionId:e.exceptionId, securityId:e.securityId,\n    evidenceReferences:e.evidenceReferences,\n    disposition:e.resolutionStatus === 'EXPLAINED' ? 'ACCEPT_VERIFIED_EXPLANATION' :\n      (e.exceptionType.startsWith('COST_BASIS_') ? 'OPEN_COST_BASIS_CASE' : 'ESCALATE_TO_TRANSFER_OPERATIONS')})),\n};\n",
        "errorHandlingEnabled": true
      }
    },
    {
      "id": "BuildResolutionPlanFailed",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "display": {
        "label": "End",
        "icon": "circle-check"
      },
      "model": {
        "type": "bpmn:EndEvent"
      },
      "inputs": {},
      "outputs": {
        "result": {
          "type": "object",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "({\n  ...$vars.ValidateInvestigation.output, workflowOutcome:'REVIEW_FAILED', verificationStatus:'NOT_VERIFIED',\n  planId:(() => {const n=Reflect.get($vars,'ValidateResolutionPlan');return n && Reflect.get(n,'output')?.planId || null;})(), planStatus:null,\n  humanReviewOutcome:null, reviewedDispositions:[], auditReference:null,\n  demoOnly:true, identityVerification:'UNVERIFIED_DEMO_REFERENCE', error:{code:'REVIEW_STEP_FAILED',failedStep:\"BuildResolutionPlan\"}\n})",
            "fieldType": "object"
          },
          "var": "result"
        },
        "backendBaseUrl": {
          "type": "string",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "$vars.backendBaseUrl",
            "fieldType": "string"
          },
          "var": "backendBaseUrl"
        },
        "reviewDecision": {
          "type": "object",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "$vars.reviewDecision",
            "fieldType": "object"
          },
          "var": "reviewDecision"
        }
      }
    },
    {
