      },
      "inputs": {},
      "outputs": {
        "result": {
          "type": "object",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "({\n  ...$vars.NormalizeReconciliation.output, evidenceOutcome: \"EVIDENCE_REVIEW_REQUIRED\",\n  extractionResult: {\n    transferId: $vars.NormalizeReconciliation.output.transferId,\n    documentType: 'CORPORATE_ACTION_NOTICE', extractedFields: {}, evidenceReference: null,\n    validationStatus: 'REVIEW_REQUIRED', discrepancies: [\"REFERENCE_REQUEST_FAILED\"], extractionStatus: 'EXTRACTION_FAILED'\n  }\n})",
