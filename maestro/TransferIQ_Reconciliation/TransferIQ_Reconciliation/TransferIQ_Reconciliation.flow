    {
      "id": "ValidateDeliveringPositions",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "ValidateDeliveringPositions",
        "icon": "code"
      },
      "inputs": {
        "script": "const response = $vars.GetDeliveringPositions.output;\nconst httpStatus = response && (Reflect.get(response, 'code') ?? Reflect.get(response, 'statusCode'));\nconst page = response && response.body;\nif (!response || httpStatus !== 200 || !page || !Array.isArray(page.items) ||\n    !Number.isSafeInteger(page.total) || page.total < 1 || page.total !== page.items.length || page.offset !== 0 || page.limit !== 100 ||\n    !page.items.every(p => p && typeof p.positionId === 'string' && typeof p.securityId === 'string' &&\n      p.accountId === $vars.ValidateTransfer.output.sourceAccountId && typeof p.quantity === 'string' &&\n      /^\\d+(\\.\\d+)?$/.test(p.quantity) && typeof p.snapshotDate === 'string')) throw new Error('INVALID_RESPONSE');\n// Never silently accept a truncated page. Step 5 supports <=100 rows per side.\nreturn page;\n",
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "2d500412-998e-4178-aaad-b4c7b34841fb"
    },
