    {
      "id": "RejectDisposition",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "RejectDisposition",
        "icon": "code"
      },
      "inputs": {
        "script": "// Reached only through the corresponding real Quick Form outcome port.\r\nconst form = $vars.quickForm1.output;\r\nconst outcome = 'REJECT';\r\nconst label = {APPROVE:'Approve',REQUEST_EVIDENCE:'Request Evidence',ESCALATE:'Escalate',REJECT:'Reject'}[outcome];\r\nif (!form || typeof form !== 'object' || form.Action !== label) throw new Error('MISSING_OR_MISMATCHED_HUMAN_FORM_OUTPUT');\r\nconst value = key => {\r\n  // Use the saved Studio field ID; older task field names remain validated aliases.\r\n  const result = key === 'reviewerComments' ? (Reflect.get(form, 'reviewerCommentsOptional') ?? Reflect.get(form, 'Reviewer comments (optional)') ?? Reflect.get(form, 'comments') ?? Reflect.get(form, 'reviewerComments') ?? '') : (Reflect.get(form, key) ?? '');\r\n  if (typeof result !== 'string' || result.length > 2000) throw new Error('INVALID_REVIEW_TEXT');\r\n  return result;\r\n};\r\nconst plan = $vars.ValidateResolutionPlan.output;\r\nreturn {planVersion:plan.planVersion,planHash:plan.planHash,reviewOutcome:outcome,\r\n  reviewerReference:$vars.ValidateInput.output.reviewerReference,\r\n  reviewerComments:value('reviewerComments'),additionalInformation:value('additionalInformation'),\r\n  // Correlation reference, NOT a claimed verified Action Center task ID.\r\n  reviewEventReference:$vars.ValidateInput.output.correlationId + ':TransferOperationsReview'};\r\n",
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the node fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "c7b0f71f-1be7-49f5-a76e-f2042f05a52d"
    },
