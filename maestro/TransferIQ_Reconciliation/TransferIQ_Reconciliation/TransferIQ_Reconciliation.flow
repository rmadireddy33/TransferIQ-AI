    {
      "id": "ValidateDemoRun",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "ValidateDemoRun",
        "icon": "code"
      },
      "inputs": {
        "script": "const response = $vars.CreateDemoRun.output;\nconst body = response?.body;\nif (![200, 201].includes(response?.code ?? (response && Reflect.get(response, 'statusCode'))) || !body ||\n    !/^DEMO-[0-9a-f]{32}$/.test(body.runId) ||\n    body.transferId !== $vars.ValidateInput.output.transferId ||\n    body.fictionalDemo !== true || body.evidenceMode !== 'LIVE_SYNTHETIC_BACKEND' ||\n    typeof body.expiresAt !== 'number' || !Number.isFinite(body.expiresAt) || body.expiresAt <= 0) {\n  throw new Error('INVALID_DEMO_RUN');\n}\nreturn { runId: body.runId, transferId: body.transferId };\n",
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "f661cc10-362f-4be5-9fc4-4e5a79218fd2"
    },
