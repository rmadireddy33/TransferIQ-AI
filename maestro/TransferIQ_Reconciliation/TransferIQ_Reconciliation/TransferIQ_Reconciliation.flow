    {
      "id": "NormalizeReconciliation",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "NormalizeReconciliation",
        "icon": "code"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output",
          "properties": {
            "transferId": {
              "type": "string"
            },
            "demoRunId": {
              "type": "string"
            },
            "reconciliationRunId": {
              "type": "string"
            },
            "workflowOutcome": {
              "type": "string"
            },
            "totalPositions": {
              "type": "number"
            },
            "directlyMatched": {
              "type": "number"
            },
            "evidenceExplained": {
              "type": "number"
            },
            "unresolvedCount": {
              "type": "number"
            },
            "costBasisIssues": {
              "type": "number"
            },
            "sourcePositions": {
              "type": "array"
            },
            "receivingStagingPositions": {
              "type": "array"
            },
            "costBasisExceptions": {
              "type": "array"
            },
            "exceptions": {
              "type": "array"
            },
            "evidenceReferences": {
              "type": "array"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "inputs": {
        "script": "const transferId = $vars.ValidateInput.output.transferId;\nconst correlationId = $vars.ValidateInput.output.correlationId;\nconst failed = {\n  transferId, reconciliationRunId: null, totalPositions: null, directlyMatched: null,\n  evidenceExplained: null, unresolvedCount: null, costBasisIssues: null,\n  exceptions: [], evidenceReferences: [], workflowOutcome: 'FAILED',\n  correlation: { correlationId, transferId, failedStep: 'NormalizeReconciliation' },\n  error: { code: 'INVALID_RECONCILIATION_RESPONSE', summary: 'Reconciliation response is incomplete, malformed or inconsistent.' }\n};\nconst response = $vars.RunReconciliation.output;\nconst httpStatus = response && (Reflect.get(response, 'code') ?? Reflect.get(response, 'statusCode'));\nconst body = response && response.body;\nconst object = x => x && typeof x === 'object' && !Array.isArray(x);\nconst text = x => typeof x === 'string' && x.length > 0;\nconst strings = x => Array.isArray(x) && x.every(text);\nconst quantity = x => x === null || (typeof x === 'string' && /^-?\\d+(\\.\\d+)?$/.test(x));\nif (!response || ![200, 201].includes(httpStatus) || !object(body) || body.transferId !== transferId ||\n    !text(body.reconciliationRunId) || body.executionStatus !== 'COMPLETED' ||\n    !['RECONCILED', 'EXCEPTIONS_DETECTED'].includes(body.status) || !object(body.summary) ||\n    !['totalPositions', 'directlyMatched', 'evidenceExplained', 'unresolved', 'costBasisIssues'].every(k => Number.isSafeInteger(body.summary[k]) && body.summary[k] >= 0) ||\n    !Array.isArray(body.positions) || !Array.isArray(body.exceptions)) return failed;\nconst summary = body.summary;\nif (summary.totalPositions < 1 || summary.totalPositions !== body.positions.length ||\n    summary.totalPositions !== summary.directlyMatched + summary.evidenceExplained + summary.unresolved ||\n    body.status !== (summary.unresolved || summary.costBasisIssues ? 'EXCEPTIONS_DETECTED' : 'RECONCILED')) return failed;\nif (!body.positions.every(p => object(p) && text(p.securityId) && ['MATCHED', 'EXPLAINED', 'UNRESOLVED'].includes(p.classification) &&\n    strings(p.evidenceReferences) && ['sourceQuantity', 'targetQuantity', 'expectedQuantity', 'difference'].every(k => quantity(p[k])) &&\n    (p.classification !== 'EXPLAINED' || p.evidenceReferences.length > 0))) return failed;\nif (new Set(body.positions.map(p => p.securityId)).size !== body.positions.length ||\n    body.positions.filter(p => p.classification === 'MATCHED').length !== summary.directlyMatched ||\n    body.positions.filter(p => p.classification === 'EXPLAINED').length !== summary.evidenceExplained ||\n    body.positions.filter(p => p.classification === 'UNRESOLVED').length !== summary.unresolved) return failed;\nif (!body.exceptions.every(e => object(e) && text(e.exceptionId) && e.transferId === transferId && e.reconciliationRunId === body.reconciliationRunId &&\n    (e.securityId === null || text(e.securityId)) && text(e.exceptionType) && text(e.description) && strings(e.evidenceReferences) &&\n    ['EXPLAINED', 'UNRESOLVED', 'REQUIRES_INVESTIGATION'].includes(e.resolutionStatus) && e.status === e.resolutionStatus &&\n    ['sourceQuantity', 'targetQuantity', 'expectedQuantity', 'normalizedQuantity', 'difference'].every(k => quantity(e[k])))) return failed;\nconst costBasisExceptions = body.exceptions.filter(e => e.exceptionType.startsWith('COST_BASIS_'));\nconst positionExceptions = body.exceptions.filter(e => !e.exceptionType.startsWith('COST_BASIS_'));\nif (costBasisExceptions.length !== summary.costBasisIssues ||\n    positionExceptions.filter(e => e.resolutionStatus === 'EXPLAINED').length !== summary.evidenceExplained ||\n    positionExceptions.filter(e => e.resolutionStatus !== 'EXPLAINED').length !== summary.unresolved ||\n    new Set(body.exceptions.map(e => e.exceptionId)).size !== body.exceptions.length ||\n    !body.positions.every(p => p.classification === 'MATCHED' || positionExceptions.some(e => e.securityId === p.securityId &&\n      (p.classification === 'EXPLAINED' ? e.resolutionStatus === 'EXPLAINED' : e.resolutionStatus !== 'EXPLAINED')))) return failed;\nconst unresolvedExceptions = positionExceptions.filter(e => e.resolutionStatus !== 'EXPLAINED');\nconst evidenceReferences = Array.from(new Set(body.positions.flatMap(p => p.evidenceReferences).concat(body.exceptions.flatMap(e => e.evidenceReferences)))).sort();\nreturn {\n  transferId, demoRunId: $vars.ValidateDemoRun.output.runId, reconciliationRunId: body.reconciliationRunId,\n  totalPositions: summary.totalPositions, directlyMatched: summary.directlyMatched,\n  evidenceExplained: summary.evidenceExplained, unresolvedCount: summary.unresolved,\n  exceptions: body.exceptions, workflowOutcome: summary.unresolved > 0 ? 'INVESTIGATION_REQUIRED' : 'CLEAN',\n  costBasisIssues: summary.costBasisIssues, costBasisExceptions,\n  requiresCostBasisReview: summary.costBasisIssues > 0, quantityReconciliationOnly: true,\n  unresolvedExceptions, affectedSecurityIdentifiers: Array.from(new Set(unresolvedExceptions.map(e => e.securityId).filter(text))),\n  exceptionClassifications: Array.from(new Set(unresolvedExceptions.map(e => e.exceptionType))), evidenceReferences,\n  explanation: summary.unresolved > 0 ? 'Unresolved position exceptions require investigation; no correction was applied.' :\n    (summary.costBasisIssues > 0 ? 'Quantities reconcile. Cost-basis evidence still requires separate review.' : 'All positions are directly matched or explained by backend-verified evidence.'),\n  transferStatus: $vars.ValidateTransfer.output.status,\n  sourcePositions: $vars.ValidateDeliveringPositions.output.items,\n  receivingStagingPositions: $vars.ValidateReceivingPositions.output.items,\n  positionKind: 'RECEIVING_TRANSFER_STAGING', settledHoldings: false,\n  correlation: { correlationId, transferId, reconciliationRunId: body.reconciliationRunId }, error: null\n};\n",
        "errorHandlingEnabled": true
      }
    },
