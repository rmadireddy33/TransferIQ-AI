            "expression": "({\n  ...$vars.ValidateInvestigation.output, workflowOutcome:'REVIEW_FAILED', verificationStatus:'NOT_VERIFIED',\n  planId:(() => {const n=Reflect.get($vars,'ValidateResolutionPlan');return n && Reflect.get(n,'output')?.planId || null;})(), planStatus:null,\n  humanReviewOutcome:null, reviewedDispositions:[], auditReference:null,\n  demoOnly:true, identityVerification:'UNVERIFIED_DEMO_REFERENCE', error:{code:'REVIEW_STEP_FAILED',failedStep:\"RecordReviewDecision\"}\n})",
            "fieldType": "object"
          },
          "var": "result"
        },
        "backendBaseUrl": {
          "type": "string",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "$vars.backendBaseUrl",
            "fieldType": "string"
          },
          "var": "backendBaseUrl"
        },
        "reviewDecision": {
          "type": "object",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "$vars.reviewDecision",
            "fieldType": "object"
          },
          "var": "reviewDecision"
        }
      },
      "uniqueId": "d5af9593-fe98-4271-989d-29c084948473"
