                  "id": "_Implicit_Edge__Implicit_HttpTask_PreviewResolutionPlan__Implicit_EndEvent_Default_PreviewResolutionPlan",
                  "source": "_Implicit_HttpTask_PreviewResolutionPlan",
                  "target": "_Implicit_EndEvent_Default_PreviewResolutionPlan",
                  "type": "bpmn:SequenceFlow",
                  "data": {}
                },
                {
                  "condition": "node.data.inputs.branches.length > 0",
                  "id": "_Implicit_Edge__Implicit_HttpTask_PreviewResolutionPlan__Implicit_Gateway_PreviewResolutionPlan",
                  "source": "_Implicit_HttpTask_PreviewResolutionPlan",
                  "target": "_Implicit_Gateway_PreviewResolutionPlan",
                  "type": "bpmn:SequenceFlow",
                  "data": {}
                },
                {
                  "forEach": "node.data.inputs.branches",
                  "condition": "node.data.inputs.branches.length > 0",
                  "id": "_Implicit_Edge__Implicit_Gateway_PreviewResolutionPlan__Implicit_EndEvent_{branchName}_PreviewResolutionPlan",
                  "source": "_Implicit_Gateway_PreviewResolutionPlan",
                  "target": "_Implicit_EndEvent_{branchName}_PreviewResolutionPlan",
                  "type": "bpmn:SequenceFlow",
                  "data": {
