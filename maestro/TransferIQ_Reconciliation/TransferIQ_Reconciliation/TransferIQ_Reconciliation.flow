    {
      "id": "ValidateCorporateAction",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "ValidateCorporateAction",
        "icon": "code"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "inputs": {
        "script": "// Current in-Flow Extract docs expose output.result. Scalar taxonomy projection\n// is intentionally strict and MUST be confirmed against a real node trace.\n// Unknown wrappers, arrays, duplicate values and guessed aliases never verify.\nconst reconciliation = $vars.NormalizeReconciliation.output;\nconst discrepancies = [];\nconst fields = { securityId: null, securityName: null, actionType: null, splitNumerator: null,\n  splitDenominator: null, effectiveDate: null, noticeDate: null, evidenceReference: null };\nconst object = x => x !== null && typeof x === 'object' && !Array.isArray(x);\nconst text = x => typeof x === 'string' && x.length > 0 && x.length <= 256 && x.trim() === x;\nconst output = Reflect.get($vars, 'CorporateActionExtractor')?.output;\nconst finish = extractionStatus => ({\n  ...reconciliation,\n  evidenceOutcome: extractionStatus === 'VERIFIED' ? 'EVIDENCE_VERIFIED' : 'EVIDENCE_REVIEW_REQUIRED',\n  extractionResult: {\n    transferId: reconciliation.transferId, documentType: 'CORPORATE_ACTION_NOTICE',\n    extractedFields: fields, evidenceReference: fields.evidenceReference ?? null,\n    validationStatus: extractionStatus === 'VERIFIED' ? 'VERIFIED' : 'REVIEW_REQUIRED',\n    discrepancies, extractionStatus,\n  },\n});\nconst owns = (obj, key) => Object.prototype.hasOwnProperty.call(obj, key);\nif (!object(output) || !owns(output, 'version') || !owns(output, 'type') ||\n    !owns(output, 'taxonomy') || !owns(output, 'metadata') || !object(output.result) || output.error) {\n  discrepancies.push('UNSUPPORTED_OR_FAILED_IXP_OUTPUT');\n  return finish('EXTRACTION_FAILED');\n}\nconst names = ['securityId', 'securityName', 'actionType', 'splitNumerator', 'splitDenominator', 'effectiveDate', 'noticeDate', 'evidenceReference'];\nfor (const name of names) {\n  const value = output.result[name];\n  if (typeof value === 'string' && value.length <= 256 || typeof value === 'number' && Number.isFinite(value)) fields[name] = value;\n  else discrepancies.push('MISSING_OR_INVALID_' + name);\n}\nfor (const name of ['securityId', 'securityName', 'actionType', 'evidenceReference']) {\n  if (!text(fields[name])) discrepancies.push('INVALID_' + name);\n}\nfor (const name of ['splitNumerator', 'splitDenominator']) {\n  // Integer ratios only, matching the backend reference contract. No quantity\n  // arithmetic or binary floating-point financial calculation is performed.\n  if (!Number.isSafeInteger(fields[name]) || fields[name] <= 0 || fields[name] > 1000000000) discrepancies.push('INVALID_' + name);\n}\nconst date = x => typeof x === 'string' && /^\\d{4}-\\d{2}-\\d{2}$/.test(x) &&\n  !Number.isNaN(Date.parse(x + 'T00:00:00Z')) && new Date(x + 'T00:00:00Z').toISOString().slice(0, 10) === x;\nfor (const name of ['effectiveDate', 'noticeDate']) if (!date(fields[name])) discrepancies.push('INVALID_' + name);\nconst relevant = reconciliation.exceptions.filter(e => e.exceptionType === 'CORPORATE_ACTION_TIMING' && e.securityId === fields.securityId &&\n  e.evidenceReferences.includes(fields.evidenceReference));\nif (!relevant.length) discrepancies.push('NO_MATCHING_TRANSFER_EXCEPTION_EVIDENCE');\nconst response = Reflect.get($vars, 'GetCorporateActionReference')?.output;\nconst body = response?.body;\nif ((response && (Reflect.get(response, 'code') ?? Reflect.get(response, 'statusCode'))) !== 200 || !object(body) ||\n    body.runId !== Reflect.get(reconciliation, 'demoRunId') || body.transferId !== reconciliation.transferId ||\n    body.fictionalDemo !== true || body.referenceSource !== 'SEEDED_REFERENCE_DATABASE' ||\n    !Array.isArray(body.items) || !Number.isSafeInteger(body.total) || body.total !== body.items.length ||\n    body.offset !== 0 || !Number.isSafeInteger(body.limit) || body.limit < body.total) {\n  discrepancies.push('REFERENCE_UNAVAILABLE_OR_INVALID');\n  return finish('REVIEW_REQUIRED');\n}\nconst matches = body.items.filter(r => object(r) && r.securityId === fields.securityId && r.evidenceReference === fields.evidenceReference);\nif (matches.length !== 1) discrepancies.push('REFERENCE_NOT_UNIQUE_OR_NOT_FOUND');\nelse {\n  const r = matches[0];\n  if (r.verified !== true) discrepancies.push('REFERENCE_NOT_VERIFIED');\n  if (r.noticeDateSource !== 'REFERENCE_CREATED_AT') discrepancies.push('UNKNOWN_NOTICE_DATE_PROVENANCE');\n  const action = x => x === 'SPLIT' ? 'STOCK_SPLIT' : x;\n  // This phase supports split notices only; other actions require investigation.\n  if (action(fields.actionType) !== 'STOCK_SPLIT' || action(r.actionType) !== 'STOCK_SPLIT') discrepancies.push('ACTION_TYPE_MISMATCH_OR_UNSUPPORTED');\n  for (const [key, reference] of [['securityName', 'securityName'], ['splitNumerator', 'numerator'],\n    ['splitDenominator', 'denominator'], ['effectiveDate', 'effectiveDate'], ['noticeDate', 'noticeDate']]) {\n    if (fields[key] !== r[reference]) discrepancies.push('REFERENCE_MISMATCH_' + key);\n  }\n}\n// A verified notice never clears the remaining exception or authorizes changes.\nreturn finish(discrepancies.length ? 'REVIEW_REQUIRED' : 'VERIFIED');\n",
        "errorHandlingEnabled": true
      }
    },
