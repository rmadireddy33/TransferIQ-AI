    {
      "id": "ValidateTransfer",
      "type": "core.action.script",
      "typeVersion": "1.1",
      "display": {
        "label": "ValidateTransfer",
        "icon": "code"
      },
      "inputs": {
        "script": "const response = $vars.GetTransferDetails.output;\n// Designer schema uses code; SDK 6.66.5 documents statusCode. Validate either envelope.\nconst httpStatus = response && (Reflect.get(response, 'code') ?? Reflect.get(response, 'statusCode'));\nconst body = response && response.body;\nif (!response || httpStatus !== 200 || !body || typeof body !== 'object' || Array.isArray(body) ||\n    body.transferId !== $vars.ValidateInput.output.transferId ||\n    !['transferId', 'clientId', 'deliveringFirmId', 'receivingFirmId', 'sourceAccountId', 'destinationAccountId'].every(k => typeof body[k] === 'string' && body[k].length > 0) ||\n    !['DRAFT', 'SUBMITTED', 'UNDER_REVIEW', 'EXCEPTION_DETECTED', 'INVESTIGATING', 'PENDING_APPROVAL', 'RESOLVED', 'ESCALATED', 'COMPLETED'].includes(body.status) ||\n    !['FULL', 'PARTIAL'].includes(body.transferType)) throw new Error('INVALID_RESPONSE');\n// Preserve the API shape: the lifecycle field is status, not transferStatus.\nreturn body;\n",
        "errorHandlingEnabled": true
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": "=result.response",
          "var": "output"
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": "=Error",
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "uniqueId": "76b91720-6ee9-46ab-9b38-2f5db6a5ece2"
    },
