                      "var": "PreviewResolutionPlan.output",
                      "custom": true
                    },
                    {
                      "name": "error",
                      "type": "jsonSchema",
                      "source": "=vars.error",
                      "var": "PreviewResolutionPlan.error",
                      "custom": true
                    }
                  ]
                }
              },
              "nodes": [
                {
                  "id": "_Implicit_StartEvent_PreviewResolutionPlan",
                  "type": "bpmn:StartEvent",
                  "parentId": "PreviewResolutionPlan",
                  "position": {
                    "x": 0,
                    "y": 0
                  },
                  "data": {
