    {
      "id": "AgentFailed",
      "type": "core.control.end",
      "typeVersion": "1.0",
      "display": {
        "label": "End",
        "icon": "circle-check"
      },
      "inputs": {},
      "outputs": {
        "result": {
          "type": "object",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "({\n                          ...$vars.NormalizeReconciliation.output, workflowOutcome: 'INVESTIGATION_REVIEW_REQUIRED',\n                          documentEvidenceStatus: $vars.ValidateInput.output.enableIXP === true ? 'IXP_SETUP_OR_EVIDENCE_REQUIRED' : 'NOT_PROCESSED_IXP_DISABLED',\n                          investigationStatus: \"AGENT_FAILED\", investigationSummary: 'Investigation could not be validated; human review is required.',\n                          findings: [], recommendedNextActions: ['REQUEST_ADDITIONAL_EVIDENCE'], humanReviewRequired: true,\n                          unresolvedExceptions: $vars.NormalizeReconciliation.output.exceptions.filter(e => e.resolutionStatus !== 'EXPLAINED'),\n                          unresolvedQuestions: [],\n                          correctionsApplied: 0, transferCompleted: false, error: { code: \"AGENT_FAILED\", failedStep: \"TransferInvestigationAgent\" }\n                        })",
