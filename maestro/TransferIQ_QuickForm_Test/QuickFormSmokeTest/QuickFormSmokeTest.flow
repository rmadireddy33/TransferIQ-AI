            "fieldType": "string"
          },
          "var": "output"
        }
      },
      "inputs": {}
    },
    {
      "id": "DummyData",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "DummyData",
        "icon": "code"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output",
          "properties": {
            "summary": {
              "type": "string"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "inputs": {
        "script": "return {summary:'TEST ONLY: fictional transfer TEST-001. Approve or reject this Quick Form connectivity test. No financial action will occur.'};"
      }
    },
    {
      "id": "QuickFormReview",
      "type": "uipath.human-in-the-loop.quick-form",
      "typeVersion": "1.9",
      "display": {
        "label": "QuickFormReview",
        "icon": "users"
      },
      "model": {
        "type": "bpmn:UserTask",
        "serviceType": "Actions.HITL"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "Task result data",
          "source": {
            "type": "literal",
            "expression": "=result",
            "fieldType": "string"
          },
          "var": "output",
          "properties": {
            "comments": {
              "type": "string",
              "fieldId": "comments"
            },
            "Action": {
              "type": "string",
              "enum": [
                "Approve",
                "Reject"
              ],
              "default": "Approve"
            }
          }
        },
        "status": {
          "type": "string",
          "description": "Task completion status (completed, cancelled, timeout)",
          "source": {
            "type": "literal",
            "expression": "=result.Action",
            "fieldType": "string"
          },
          "var": "status",
          "enum": [
            "Approve",
            "Reject"
          ],
          "default": "Approve"
        }
      },
      "inputs": {
        "schema": {
          "schemaId": "14c7e6d0-bc3d-4c58-a452-eab093078684",
          "title": "TransferIQ Quick Form Smoke Test",
          "fields": [
            {
              "id": "summary",
              "label": "Dummy test summary",
              "type": "string",
              "direction": "input",
              "binding": "vars.DummyData.output.summary"
            },
            {
              "id": "comments",
              "label": "Comments (optional)",
              "type": "string",
              "direction": "output"
            }
          ],
          "outcomes": [
            {
              "id": "approve",
              "name": "Approve",
              "type": "string",
              "isPrimary": true,
              "action": "Continue"
            },
            {
              "id": "reject",
              "name": "Reject",
              "type": "string",
              "isPrimary": false,
              "action": "Continue"
            }
          ]
        },
        "enableDecisionSchema": false,
        "recipient": {
          "channels": [
            "ActionCenter"
          ],
          "connections": {},
          "assignee": {
            "type": "user",
            "value": "ravindra.reddy33@gmail.com",
            "displayName": "ravindra.reddy33@gmail.com"
          }
        }
      }
    },
    {
      "id": "CaptureDecision",
      "type": "core.action.script",
      "typeVersion": "1.0.0",
      "display": {
        "label": "CaptureDecision",
        "icon": "code"
      },
      "model": {
        "type": "bpmn:ScriptTask"
      },
      "outputs": {
        "output": {
          "type": "object",
          "description": "The return value of the script",
          "source": {
            "type": "literal",
            "expression": "=result.response",
            "fieldType": "string"
          },
          "var": "output",
          "properties": {
            "testOnly": {
              "type": "boolean"
            },
            "outcome": {
              "type": "string"
            },
            "comments": {
              "type": "string"
            },
            "summary": {
              "type": "string"
            }
          }
        },
        "error": {
          "type": "object",
          "description": "Error information if the script fails",
          "source": {
            "type": "literal",
            "expression": "=result.Error",
            "fieldType": "string"
          },
          "var": "error",
          "schema": {
            "$schema": "http://json-schema.org/draft-07/schema#",
            "type": "object",
            "required": [
              "code",
              "message",
              "detail",
              "category",
              "status"
            ],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code as a string"
              },
              "message": {
                "type": "string",
                "description": "High-level error message"
              },
              "detail": {
                "type": "string",
                "description": "Detailed error description"
              },
              "category": {
                "type": "string",
                "description": "Error category"
              },
              "status": {
                "type": "integer",
                "description": "HTTP status code"
              }
            },
            "additionalProperties": false
          }
        }
      },
      "inputs": {
        "script": "const result=$vars.QuickFormReview.output; if (!result || !['Approve','Reject'].includes(result.Action)) throw new Error('Missing actual human outcome'); if (result.comments != null && typeof result.comments !== 'string') throw new Error('Invalid comments'); return {testOnly:true,outcome:result.Action,comments:result.comments || '',summary:$vars.DummyData.output.summary};"
      }
    },
    {
      "id": "TestResult",
      "type": "core.control.end",
      "typeVersion": "1.0.0",
      "display": {
        "label": "End",
        "icon": "circle-check"
      },
      "model": {
        "type": "bpmn:EndEvent"
      },
      "inputs": {},
      "outputs": {
        "result": {
          "type": "object",
          "description": "",
          "source": {
            "type": "jsExpression",
            "expression": "$vars.CaptureDecision.output",
            "fieldType": "object"
          },
          "var": "result"
        }
      }
    }
  ],
