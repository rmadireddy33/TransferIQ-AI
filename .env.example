# Backend configuration. Process environment overrides the repository-root .env locally.
# Copy to .env locally. Set secrets through Railway environment settings in cloud.
APP_ENV=development
SEED_DEMO_DATA=0
# The launcher reads PORT from process environment, not this local .env file.
# Railway supplies PORT automatically; locally use $env:PORT='8000'.
PORT=8000
# Prevent Python bytecode writes into the deployed source tree.
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1

# Local relative paths resolve against repository root. Set DATA_DIR=/data in cloud.
# SQLite URL is derived from DATA_DIR/transferiq.db using SQLAlchemy.
# No DATABASE_URL override: SQLite is the only supported database.
DATA_DIR=./data
SQLITE_BUSY_TIMEOUT_MS=5000
MAX_DOCUMENT_BYTES=10485760

# Mutation, reconciliation/reference and document endpoints require X-API-Key.
# Production startup refuses a blank API_KEY. Core demo GETs remain public.
# Never expose this key in a VITE_* variable or browser bundle.
API_KEY=
# The remaining settings are reserved for later phases and are not consumed yet.
# Separate operator/reviewer session authentication will be implemented later.
SESSION_SECRET=
# Development-only origin; restrict to deployed origin in cloud.
CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_PUBLIC_BASE_URL=http://localhost:8000

# UiPath placeholders: verify real tenant contracts and scopes during integration.
# Disabled means unavailable, never simulated integration success.
UIPATH_ENABLED=false
UIPATH_BASE_URL=
UIPATH_ORGANIZATION=
UIPATH_TENANT=
UIPATH_FOLDER_ID=
UIPATH_OAUTH_TOKEN_URL=
UIPATH_CLIENT_ID=
UIPATH_CLIENT_SECRET=
UIPATH_OAUTH_SCOPES=
UIPATH_MAESTRO_PROCESS_KEY=
UIPATH_IXP_PROJECT_ID=
UIPATH_IXP_MODEL_ID=
UIPATH_AGENT_PROCESS_KEY=
# Quick Form task/resource binding and trusted decision verification are deferred
# until the tenant's supported contract is verified. No approval bypass setting.
